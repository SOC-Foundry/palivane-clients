#!/usr/bin/env python3
r"""palivane-secrets — endpoint credential-hygiene scan (secrets at rest).

Infostealers harvest credentials that are already sitting on the machine — SSH/RSA keys,
`~/.aws/credentials`, `.git-credentials`, `.env` files, CI tokens in shell history. This
scanner finds them *before* a stealer does and reports them to Palivane as
`credential_at_rest` findings.

Privacy by design — detection runs **locally** and only METADATA leaves the box: the
secret *type*, file path, line, a masked preview (`ghp_••••4f2a`), and whether the file is
world/group-readable. The raw secret never leaves the device, so Palivane never becomes the
exfil path. Reports to POST /api/scan/secrets.

Cross-platform: POSIX reads mode bits for readability; Windows reads the NTFS ACL via
`icacls` (mode bits are meaningless there) and additionally scans the Windows-native
credential homes — %APPDATA%\gcloud, PowerShell history, Git Credential Manager, .ppk/
.pfx exports — that the ~-dotfile list alone would miss. When readability can't be
determined the field is null (not false), so the server records "unknown" instead of
silently claiming the file is private.

    palivane-secrets                 # scan well-known locations + dev roots, report to Palivane
    palivane-secrets --dry-run       # print what would be reported; send nothing
    palivane-secrets --root ~/work   # add an extra directory to the .env sweep
    palivane-secrets --engine trufflehog   # drive TruffleHog (~800 detectors + live verify)
    palivane-secrets --engine gitleaks     # drive Gitleaks instead of the built-in patterns

With --engine, Palivane runs the external scanner if it's on PATH, masks its findings
locally (raw secrets never leave), and feeds the same pipeline; falls back to the built-in
regex scan if the tool isn't installed. For CI, pipe a scanner's JSON to `palivane-import`.

Config: PALIVANE_URL + PALIVANE_TOKEN (an ak_… key) from the environment, else the gateway
pair in ~/.claude/settings.json / ~/.cursor/palivane.json. Stdlib only.
"""

from __future__ import annotations

import json
import math
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.request
from collections import Counter



# --- Detection ---------------------------------------------------------------------------
# Shared with palivane-s3-scan (palivane_detect.py) so both scanners agree and neither
# drifts. install.sh puts it beside this script; if it is somehow absent, fetch it from the
# deployment rather than failing with an ImportError the user cannot act on.
def _load_detect():
    import importlib.util
    here = os.path.dirname(os.path.abspath(__file__))
    path = os.path.join(here, "palivane_detect.py")
    if not os.path.exists(path):
        base = (os.environ.get("PALIVANE_URL") or "").rstrip("/")
        if not base:
            sys.exit("palivane_detect.py is missing and PALIVANE_URL is unset; reinstall "
                     "with install.sh, or place it beside this script.")
        try:
            with urllib.request.urlopen(base + "/cli/palivane_detect.py", timeout=20) as r:
                body = r.read()
            path = os.path.join(tempfile.gettempdir(), "palivane_detect.py")
            with open(path, "wb") as fh:
                fh.write(body)
        except Exception as e:                                    # noqa: BLE001
            sys.exit(f"could not fetch palivane_detect.py from {base}: {e}")
    spec = importlib.util.spec_from_file_location("palivane_detect", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_detect = _load_detect()
mask = _detect.mask
scan_text = _detect.scan_text
_ENTROPY_LABEL = _detect._ENTROPY_LABEL

# --- Secret patterns (mirrors backend patterns.py labels so the server scores by type) ---
# Canonical formats (separator present) + separator-STRIPPED evasion variants: a key whose
# dash/underscore was deleted to dodge DLP is caught and labeled "(separator stripped —
# likely bypass)". OpenAI/Anthropic keep a distinctive sub-marker in the stripped form; a
# bare de-dashed `sk` would match words, so that case is left to server-side entropy.
# Only trust a generic key=value credential in files that are meant to hold config/secrets.
# Credentials embedded in a connection URL (postgres://user:pass@host, mongodb+srv://…,
# redis://…) — the password sits inside the URL, so the key=value rule above misses it.
# Values that are placeholders/templates, not real secrets — keeps .env.example, docs, and
# ${VAR}/$VAR interpolation from false-positiving on the assignment + connection-URL rules.
# Tier-2 generic secret heuristic: a long, high-entropy token with no recognized prefix
# (novel/vendor keys). Mirrors the backend (patterns.find_high_entropy_tokens) — 24–80 chars
# of [A-Za-z0-9_], ≥2 character classes, Shannon entropy ≥ 3.6, and not a plain hex digest
# (git SHAs / md5). Reported under the label the server already knows for entropy findings.
# --- Where credentials actually live -----------------------------------------------------
# Well-known credential files (~-relative). Globs allowed.
_TARGET_GLOBS = [
    "~/.ssh/id_*", "~/.ssh/*.pem", "~/.ssh/*.key",
    "~/.aws/credentials",
    "~/.config/gh/hosts.yml", "~/.config/gh/hosts.yaml",
    "~/.git-credentials",
    "~/.npmrc", "~/.pypirc", "~/.netrc",
    "~/.docker/config.json",
    "~/.kube/config",
    # cloud service-account keys / tokens — crown jewels for lateral movement
    "~/.config/gcloud/application_default_credentials.json",
    "~/.config/gcloud/legacy_credentials/*/adc.json",
    "~/.azure/accessTokens.json", "~/.azure/azureProfile.json",
    # database + vault credentials
    "~/.pgpass", "~/.my.cnf", "~/.mylogin.cnf",
    "~/.vault_pass", "~/.vault-password", "~/.ansible_vault_password",
    "~/.bash_history", "~/.zsh_history",
]
# Windows puts most tool credentials under %APPDATA%/%LOCALAPPDATA% rather than in ~
# dotfiles, so the POSIX list above misses them entirely on Windows. These are additive:
# the dotfile paths still apply (git/ssh/aws/npm use them on Windows too).
_TARGET_GLOBS_WIN = [
    # PowerShell history — the direct analogue of .bash_history and a notorious leak.
    r"%APPDATA%\Microsoft\Windows\PowerShell\PSReadLine\ConsoleHost_history.txt",
    # gcloud / Azure / npm / NuGet in their Windows homes
    r"%APPDATA%\gcloud\application_default_credentials.json",
    r"%APPDATA%\gcloud\legacy_credentials\*\adc.json",
    r"%APPDATA%\npm\etc\npmrc",
    r"%APPDATA%\NuGet\NuGet.Config",
    r"%USERPROFILE%\.azure\accessTokens.json",
    r"%USERPROFILE%\.azure\azureProfile.json",
    # Git Credential Manager store + PuTTY/WinSCP private keys
    r"%LOCALAPPDATA%\GitCredentialManager\store\*",
    r"%USERPROFILE%\*.ppk",
    r"%USERPROFILE%\Documents\*.ppk",
    # Certificate/keystore exports people leave in the profile
    r"%USERPROFILE%\Downloads\*.pfx", r"%USERPROFILE%\Downloads\*.p12",
    r"%USERPROFILE%\Desktop\*.pfx", r"%USERPROFILE%\Desktop\*.p12",
]
# Dev/data roots swept (bounded). Add more via PALIVANE_SECRETS_ROOTS (e.g. server paths
# /etc:/opt:/srv) or --root; Desktop/Documents catch exported keys people leave lying around.
_DEFAULT_ROOTS = ["~/src", "~/code", "~/projects", "~/dev", "~/repos", "~/work",
                  "~/Desktop", "~/Documents", "."]
# Windows-typical code locations (Visual Studio defaults to source\repos) + OneDrive-backed
# profile folders, which is where Desktop/Documents actually live on managed machines.
_DEFAULT_ROOTS_WIN = [r"%USERPROFILE%\source\repos", r"%USERPROFILE%\OneDrive\Documents",
                      r"%USERPROFILE%\OneDrive\Desktop"]
_PRUNE = {"node_modules", ".git", ".venv", "venv", "dist", "build", "__pycache__", ".next",
          ".cache", "target", "vendor"}
_MAX_BYTES = 1_000_000       # skip files bigger than 1 MB (not credential stores)
_MAX_DEPTH = 4
_PRIVKEY_NAMES = ("id_rsa", "id_ed25519", "id_ecdsa", "id_dsa")
# Binary keystores — private by definition, so flag them by extension (content scan can't
# read the binary). .pem/.key stay content-scanned (a public cert has no PRIVATE KEY header).
_PRIVKEY_EXTS = (".p12", ".pfx", ".pkcs12", ".ppk")
# Filenames/extensions in a repo that routinely carry secrets — content-scanned in the sweep.
_CONFIG_NAMES = {"settings.py", "config.py", "secrets.py", "config.yml", "config.yaml",
                 "secrets.yml", "secrets.yaml", "appsettings.json", "application.properties",
                 "application.yml", "application.yaml", "wp-config.php", "config.php",
                 "database.yml", "docker-compose.yml", "docker-compose.yaml", "credentials"}
_SECRET_EXTS = (".pem", ".key", ".p12", ".pfx", ".pkcs12", ".ppk", ".tfstate", ".tfstate.backup")


def _sweep_match(fn: str) -> bool:
    """Should this file in a dev/data root be content-scanned? .env-style, known config
    files, key/cert material, Terraform state, and cloud service-account JSON."""
    low = fn.lower()
    if fn == ".env" or fn.startswith(".env.") or fn.endswith(".env"):
        return True
    if low in _CONFIG_NAMES or low.endswith(_SECRET_EXTS):
        return True
    if low.endswith(".json") and ("service-account" in low or "serviceaccount" in low):
        return True
    return False


def _sweep_roots(extra: list[str]) -> list[str]:
    """Default roots + PALIVANE_SECRETS_ROOTS (os.pathsep- or comma-separated) + --root."""
    env = os.getenv("PALIVANE_SECRETS_ROOTS", "").replace(",", os.pathsep)
    env_roots = [r for r in env.split(os.pathsep) if r.strip()]
    defaults = _DEFAULT_ROOTS + (_DEFAULT_ROOTS_WIN if os.name == "nt" else [])
    seen, out = set(), []
    for r in defaults + env_roots + extra:
        if r not in seen:
            seen.add(r); out.append(r)
    return out


# Windows ACL identities that mean "any local user can read this". Matched against the
# trustee names icacls prints; localized Windows also prints the SID form for well-known
# accounts in some locales, so both are listed.
_WIN_OPEN_TRUSTEES = ("everyone", "authenticated users", "builtin\\users", "users",
                      "s-1-1-0", "s-1-5-11", "s-1-5-32-545")
# Read-ish rights in icacls output: (R), (RX), (M)odify, (F)ull, or generic read (GR).
_WIN_READ_RIGHTS = ("f", "m", "rx", "r", "gr", "ge")


def _win_world_readable(path: str) -> bool | None:
    """Whether a non-owner local user can read `path` on Windows, via icacls. Returns None
    when the answer can't be determined (icacls missing, localized output we can't parse) —
    the POSIX mode bits are meaningless on NTFS, so guessing False would under-report a
    file that Everyone can in fact read."""
    try:
        out = subprocess.run(["icacls", path], capture_output=True, text=True,
                             timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0 or not out.stdout:
        return None
    # Each ACE is "TRUSTEE:(FLAG)(FLAG)…", e.g. "BUILTIN\Users:(I)(RX)". Trustees may
    # contain spaces ("NT AUTHORITY\Authenticated Users") and domain prefixes. icacls
    # echoes the queried path before the first ACE — drop it, or its own backslashes and
    # spaces get parsed as part of that trustee's name.
    ace = re.compile(r"([\w .\-]+(?:\\[\w .\-]+)?):((?:\([^)]*\))+)")
    for line in out.stdout.replace(path, " ").splitlines():
        for trustee, flags in ace.findall(line):
            name = trustee.strip().lower()
            short = name.rsplit("\\", 1)[-1]
            if name not in _WIN_OPEN_TRUSTEES and short not in _WIN_OPEN_TRUSTEES:
                continue
            rights = {f.strip().lower() for f in flags.replace("(", " ").replace(")", " ").split()}
            if rights & set(_WIN_READ_RIGHTS):
                return True
    return False


def world_readable(path: str) -> bool | None:
    """True when a user other than the owner can read the file, False when they can't,
    None when unknowable on this platform. The server treats None as "no posture signal"
    rather than "safe"."""
    if os.name == "nt":
        return _win_world_readable(path)
    try:
        return bool(os.stat(path).st_mode & (stat.S_IRGRP | stat.S_IROTH))
    except OSError:
        return None


def _read(path: str) -> str | None:
    try:
        if os.path.getsize(path) > _MAX_BYTES:
            return None
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return f.read()
    except (OSError, ValueError):
        return None


def scan_file(path: str) -> dict | None:
    """Scan one file; return a report dict (metadata only) or None if clean/unreadable."""
    # Binary keystores are private by definition — flag by extension (content is unreadable).
    if os.path.splitext(path)[1].lower() in _PRIVKEY_EXTS:
        return {"path": path, "secret_types": ["Private key block"], "masked": "••••",
                "line": 1, "world_readable": world_readable(path)}
    text = _read(path)
    if text is None:
        return None
    hits = scan_text(text)
    # A private-key *file* by name is a finding even if the header regex is oddly formatted.
    base = os.path.basename(path)
    if not hits and base in _PRIVKEY_NAMES and "PRIVATE KEY" in text:
        hits = [("Private key block", 1, "••••")]
    if not hits:
        return None
    types = list(dict.fromkeys(t for t, _, _ in hits))
    first = hits[0]
    return {"path": path, "secret_types": types, "masked": first[2], "line": first[1],
            "world_readable": world_readable(path)}


def iter_target_files(extra_roots: list[str]) -> list[str]:
    """All candidate files: well-known credential paths + a bounded sweep of dev/data roots
    for .env-style, config, key/cert, Terraform-state, and service-account files."""
    import glob
    paths: list[str] = []
    globs = _TARGET_GLOBS + (_TARGET_GLOBS_WIN if os.name == "nt" else [])
    for g in globs:
        # expandvars first so the Windows %APPDATA%-style entries resolve; expanduser
        # handles the ~ ones. An unset variable stays literal and simply matches nothing.
        pat = os.path.expanduser(os.path.expandvars(g))
        # Normalize separators to this platform's (no-op on Windows, where os.sep is "\").
        paths.extend(glob.glob(pat.replace("\\", os.sep)))
    for root in _sweep_roots(extra_roots):
        base = os.path.expanduser(root)
        if not os.path.isdir(base):
            continue
        base_depth = base.rstrip(os.sep).count(os.sep)
        for dirpath, dirnames, filenames in os.walk(base):
            if dirpath.count(os.sep) - base_depth >= _MAX_DEPTH:
                dirnames[:] = []
            dirnames[:] = [d for d in dirnames if d not in _PRUNE and not d.startswith(".")
                           or d == ".config"]
            for fn in filenames:
                if _sweep_match(fn):
                    paths.append(os.path.join(dirpath, fn))
    # De-dup, keep only regular files.
    seen, out = set(), []
    for p in paths:
        rp = os.path.realpath(p)
        if rp not in seen and os.path.isfile(p):
            seen.add(rp)
            out.append(p)
    return out


def _settings_env(path: str) -> dict:
    try:
        with open(os.path.expanduser(path)) as f:
            data = json.load(f)
        env = data.get("env") if isinstance(data, dict) else None
        return env if isinstance(env, dict) else (data if isinstance(data, dict) else {})
    except Exception:
        return {}


def read_config() -> dict:
    url = os.getenv("PALIVANE_URL", "")
    token = os.getenv("PALIVANE_TOKEN", "")
    if not url or not token:
        claude = _settings_env("~/.claude/settings.json")
        cursor = _settings_env("~/.cursor/palivane.json")
        token = token or claude.get("PALIVANE_TOKEN", "") or cursor.get("token", "")
        if not token:
            gw = claude.get("ANTHROPIC_AUTH_TOKEN", "")
            if isinstance(gw, str) and gw.startswith("ak_"):
                token = gw
        if not url:
            url = claude.get("PALIVANE_URL", "") or cursor.get("url", "")
            if not url:
                base = claude.get("ANTHROPIC_BASE_URL", "")
                if isinstance(base, str) and base:
                    url = base[:-3] if base.rstrip("/").endswith("/v1") else base
    return {"url": url.rstrip("/"), "token": token}


def post_batch(cfg: dict, items: list[dict], host: str, timeout: float = 15.0) -> dict | None:
    try:
        req = urllib.request.Request(
            cfg["url"] + "/api/scan/secrets", method="POST",
            data=json.dumps({"items": items, "host": host, "record": True}).encode(),
            headers={"content-type": "application/json", "User-Agent": "palivane-secrets/1.0", "X-Palivane-Token": cfg["token"]})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception as e:
        print(f"  (report failed: {e})", file=sys.stderr)
        return None


# --- Optional external engines (TruffleHog / Gitleaks) --------------------------------
# When requested, drive a heavier scanner locally and normalize + MASK its output here, so
# only metadata leaves (same privacy contract as the built-in scan). TruffleHog additionally
# *verifies* whether a credential is live. Falls back to the built-in scan if not installed.
_TH_MAP = {"Github": "GitHub token", "GitHub": "GitHub token", "AWS": "AWS access key id",
           "GitLab": "GitLab PAT", "PrivateKey": "Private key block", "OpenAI": "OpenAI API key",
           "Anthropic": "Anthropic API key", "SlackWebhook": "Slack webhook",
           "Slack": "Slack token", "StripeApiKey": "Stripe secret key",
           "NpmToken": "npm token", "PyPI": "PyPI token"}
_GL_MAP = {"github-pat": "GitHub token", "aws-access-token": "AWS access key id",
           "gitlab-pat": "GitLab PAT", "private-key": "Private key block",
           "openai-api-key": "OpenAI API key", "slack-webhook-url": "Slack webhook",
           "stripe-access-token": "Stripe secret key", "npm-access-token": "npm token",
           "pypi-upload-token": "PyPI token"}


def _run(cmd: list[str]) -> str | None:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=900).stdout
    except FileNotFoundError:
        return None
    except Exception:
        return ""


def _engine_findings(engine: str, roots: list[str]) -> list[dict] | None:
    """Findings from an external scanner over `roots`, masked to metadata. Returns None if
    the tool isn't on PATH (caller falls back to the built-in scan)."""
    roots = [r for r in roots if os.path.exists(r)]
    if engine == "trufflehog":
        if not shutil.which("trufflehog"):
            return None
        out = _run(["trufflehog", "filesystem", *roots, "--json", "--no-update"])
        if out is None:
            return None
        found = []
        for line in out.splitlines():
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if not isinstance(o, dict) or "DetectorName" not in o:
                continue
            data = (o.get("SourceMetadata") or {}).get("Data") or {}
            src = data.get("Filesystem") or data.get("Git") or {}
            path = src.get("file") or ""
            det = o.get("DetectorName", "secret")
            found.append({"path": path or "(unknown)", "secret_types": [_TH_MAP.get(det, det)],
                          "masked": mask(o.get("Raw") or o.get("RawV2") or ""),
                          "line": int(src.get("line", 0) or 0),
                          "world_readable": world_readable(path) if path else None,
                          "verified": bool(o.get("Verified")), "source": "trufflehog"})
        return found
    if engine == "gitleaks":
        if not shutil.which("gitleaks"):
            return None
        found = []
        for r in roots:
            out = _run(["gitleaks", "detect", "--no-git", "-s", r, "-f", "json", "-r", "/dev/stdout"])
            if out is None:
                return None
            try:
                arr = json.loads(out) if out.strip() else []
            except ValueError:
                arr = []
            for o in arr if isinstance(arr, list) else []:
                path, rule = o.get("File") or "", o.get("RuleID") or "secret"
                found.append({"path": path or "(unknown)", "secret_types": [_GL_MAP.get(rule, rule)],
                              "masked": mask(o.get("Secret") or o.get("Match") or ""),
                              "line": int(o.get("StartLine", 0) or 0),
                              "world_readable": world_readable(path) if path else None,
                              "verified": False, "source": "gitleaks"})
        return found
    return None


def main() -> int:
    args = sys.argv[1:]
    dry = "--dry-run" in args
    extra_roots = [args[i + 1] for i, a in enumerate(args) if a == "--root" and i + 1 < len(args)]
    engine = next((args[i + 1].strip().lower() for i, a in enumerate(args)
                   if a == "--engine" and i + 1 < len(args)), "")

    findings = None
    if engine:
        roots = [os.path.expanduser(r) for r in _sweep_roots(extra_roots)]
        findings = _engine_findings(engine, roots)
        if findings is None:
            print(f"'{engine}' not found on PATH — falling back to the built-in scan.",
                  file=sys.stderr)
    if findings is None:
        findings = [f for f in (scan_file(p) for p in iter_target_files(extra_roots)) if f]

    if not findings:
        print("✓ No credentials found at rest in the scanned locations.")
        return 0

    print(f"Found {len(findings)} file(s) with credentials at rest:")
    for f in findings:
        perm = "  [world/group-readable]" if f.get("world_readable") else ""
        vtag = "  VERIFIED-LIVE" if f.get("verified") else ""
        src = f"  via {f['source']}" if f.get("source") and f["source"] != "palivane" else ""
        print(f"  • {f['path']}:{f['line']}  {', '.join(f['secret_types'])}  ({f['masked']}){perm}{vtag}{src}")

    if dry:
        print("\n(--dry-run: nothing sent to Palivane)")
        return 0

    cfg = read_config()
    if not cfg["url"] or not cfg["token"]:
        print("\nNot connected to Palivane (set PALIVANE_URL/PALIVANE_TOKEN or run palivane-connect); "
              "findings not reported.", file=sys.stderr)
        return 0
    host = os.getenv("PALIVANE_HOST") or os.uname().nodename
    resp = post_batch(cfg, findings, host)
    if resp:
        print(f"\nReported to Palivane: {resp.get('flagged', 0)} flagged of "
              f"{resp.get('scanned', 0)} scanned. Review + rotate in the console.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # never disrupt the user
