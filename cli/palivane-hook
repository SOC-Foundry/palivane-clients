#!/usr/bin/env python3
"""palivane-hook — Claude Code hook: local, pre-execution inspection of tool calls & prompts.

The egress proxy can't see agent actions that never touch the network (local stdio MCP
servers, file access, shell commands), and cert-pinned clients bypass it entirely. And
with the default subscription sign-in (no gateway rerouting), the typed prompt goes
straight to api.anthropic.com with nothing of Palivane's in the path. This hook closes both
gaps from inside Claude Code itself, dispatching on `hook_event_name`:

  PreToolUse       -> every tool call *before execution*, mapped to Palivane's MCP-activity
                      shape -> /api/ingest/mcp (dangerous commands, sensitive resources,
                      tool poisoning, secrets/PII in arguments)
  UserPromptSubmit -> the user's typed prompt *before it leaves the device*
                      -> /api/ingest/ai-usage (secrets/PII/data-loss on the prompt — the
                      piece nothing else sees under subscription auth)

Monitor by default: tool-call verdicts are recorded with zero added latency (the report
is posted by a detached child process). Prompts are the exception: they are scanned
inline even in monitor mode so a confirmed secret/PII leak (`force_block`) is stopped
before it leaves — same rule as the egress proxy: block the certain, monitor the fuzzy.
Set PALIVANE_ENFORCE=true to also block on ordinary high-risk verdicts — tool calls are
then scanned synchronously and denied with the reason shown to the model; blocked prompts
are erased with the reason shown to the user. The org can set that stance centrally
(console Settings → Enforcement): `palivane-connect` provisions it at connect time, and
inline verdicts carry the live value in their `enforce` field. That value (which a per-user
policy override also sets) is remembered for an hour under ~/.palivane, so tool calls scan
inline whenever the server last said this actor is enforced. Under enforce, an org that
turned on ASK (console Settings → Policy) also has a tool call that scores in the warn band
put to the developer as Claude Code's own permission prompt, with the reason, instead of
running silently; a block stays a block. Fails open on any error: Palivane being down never
breaks the developer.

Installed by `palivane-connect` (PreToolUse + UserPromptSubmit entries in
~/.claude/settings.json), or manually:

    {"hooks": {"PreToolUse": [{"matcher": "*", "hooks": [
        {"type": "command", "command": "/path/to/palivane-hook", "timeout": 10}]}],
      "UserPromptSubmit": [{"hooks": [
        {"type": "command", "command": "/path/to/palivane-hook", "timeout": 10}]}]}}

Config: PALIVANE_URL + PALIVANE_TOKEN (an ak_… key) from the environment, else from the
`env` block of ~/.claude/settings.json (where palivane-connect writes them; the gateway
token ANTHROPIC_AUTH_TOKEN doubles as the ingest credential). Stdlib only.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import re
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request

# Tool calls with no security surface — pure agent bookkeeping. Never reported.
# Reported in the User-Agent so the console can inventory client builds per device.
VERSION = "1.3.3"
_VER_RE = re.compile(r"^[A-Za-z0-9._+-]{1,24}$")


def agent_ua(event: dict | None = None) -> str:
    """Our User-Agent, with the HOST agent's build in a parenthetical:

        palivane-hook/1.1.0 (claude-code/2.1.4)

    The server already inventories OUR build; this says which vendor build was live. When a
    shape changes under us the first question is "since which release", and a date is a much
    worse answer than a version. Claude Code does not currently put its version in the hook
    payload, so this reads it where it may appear and reports the agent without a version
    otherwise — never a guess."""
    ver = ""
    if isinstance(event, dict):
        v = event.get("version") or event.get("claude_code_version")
        if isinstance(v, str) and _VER_RE.match(v):
            ver = v
    if not ver:
        v = os.environ.get("CLAUDE_CODE_VERSION", "")
        if _VER_RE.match(v or ""):
            ver = v
    return f"palivane-hook/{VERSION} (claude-code{'/' + ver if ver else ''})"


# The assistant's own to-do list, questions and plan mode: they touch nothing, and their text
# quotes paths and commands the way any plan does ("check perms on ~/.ssh/"), which scored
# critical/block. Mirrors BOOKKEEPING_BUILTINS in the backend's mcp_guard, which also ignores
# them for older hooks and for the proxy path.
SKIP_TOOLS = {"TodoWrite", "Task", "ExitPlanMode", "EnterPlanMode", "AskUserQuestion",
              "TaskCreate", "TaskUpdate", "TaskGet", "TaskList", "TaskOutput", "TaskStop"}

_MAX_ARGS_TEXT = 20000


def _harvest_strings(obj, out: list[str]) -> None:
    """Recursively collect string *values* from an arbitrary JSON structure (dict keys
    are ignored) — scans unknown tool-input shapes without a per-tool parser."""
    if isinstance(obj, str):
        if len(obj) >= 2:
            out.append(obj)
    elif isinstance(obj, dict):
        for v in obj.values():
            _harvest_strings(v, out)
    elif isinstance(obj, list):
        for v in obj:
            _harvest_strings(v, out)


def _settings_env(path: str = "~/.claude/settings.json") -> dict:
    """The `env` block of Claude Code's settings file ({} if unreadable)."""
    try:
        with open(os.path.expanduser(path)) as f:
            env = json.load(f).get("env")
        return env if isinstance(env, dict) else {}
    except Exception:
        return {}


def read_config() -> dict:
    """Resolve backend URL/token/mode: environment first, then ~/.claude/settings.json.

    The settings fallback makes the hook independent of whether Claude Code exports the
    settings `env` block to hook processes. palivane-connect writes PALIVANE_URL/PALIVANE_TOKEN
    there; the gateway credential (ANTHROPIC_AUTH_TOKEN, an ak_… key valid for ingest
    too) and ANTHROPIC_BASE_URL (the gateway, minus /v1) serve as final fallbacks."""
    senv = _settings_env()
    url = os.getenv("PALIVANE_URL") or senv.get("PALIVANE_URL", "")
    token = os.getenv("PALIVANE_TOKEN") or senv.get("PALIVANE_TOKEN", "")
    if not token:
        gw = senv.get("ANTHROPIC_AUTH_TOKEN", "")
        if isinstance(gw, str) and gw.startswith("ak_"):
            token = gw
    if not url:
        base = senv.get("ANTHROPIC_BASE_URL", "")
        if isinstance(base, str) and base:
            url = base.rstrip("/")
            if url.endswith("/v1"):
                url = url[: -len("/v1")]
    enforce = (os.getenv("PALIVANE_ENFORCE") or senv.get("PALIVANE_ENFORCE") or "").lower() in ("1", "true", "yes")
    try:
        timeout = float(os.getenv("PALIVANE_HOOK_TIMEOUT", "5"))
    except ValueError:
        timeout = 5.0
    user = os.getenv("PALIVANE_USER") or senv.get("PALIVANE_USER", "")
    # Directories to NOT inspect (e.g. the Palivane repo itself, whose test fixtures are full
    # of realistic-looking secrets) — os.pathsep- or comma-separated absolute paths.
    raw_excl = os.getenv("PALIVANE_HOOK_EXCLUDE_DIRS") or senv.get("PALIVANE_HOOK_EXCLUDE_DIRS", "")
    exclude = [os.path.realpath(os.path.expanduser(p)) for p in
               raw_excl.replace(",", os.pathsep).split(os.pathsep) if p.strip()]
    return {"url": url, "token": token, "enforce": enforce, "timeout": timeout,
            "user": user, "exclude": exclude}


def _is_excluded(cwd: str, exclude: list) -> bool:
    """True if the session's working directory is at/under an excluded dir — so developing
    Palivane itself doesn't flag its own secret fixtures on every tool call."""
    if not cwd or not exclude:
        return False
    try:
        rp = os.path.realpath(os.path.expanduser(cwd))
    except OSError:
        return False
    return any(rp == d or rp.startswith(d + os.sep) for d in exclude)


def _touches_excluded(tool_input: dict, exclude: list) -> bool:
    """True if a tool call TARGETS a path inside an excluded directory.

    _is_excluded covers the session's cwd, which is not the same question. A session rooted
    at ~ that reads ~/Palivane/backend/tests/... is not excluded by cwd, so the repo's
    deliberately realistic fixtures (AKIA keys, .aws/credentials, `rm -rf /` in detector
    corpora) still produced findings — which is exactly what setting the exclusion was meant
    to prevent. Match on the paths in the call as well as on where the session started.
    """
    if not exclude or not isinstance(tool_input, dict):
        return False
    paths: list[str] = []
    _harvest_strings(tool_input, paths)
    for raw in paths:
        if not raw or os.sep not in raw:
            continue
        try:
            rp = os.path.realpath(os.path.expanduser(raw.strip()))
        except (OSError, ValueError):
            continue
        if any(rp == d or rp.startswith(d + os.sep) for d in exclude):
            return True
    return False


def build_activity(tool_name: str, tool_input: dict) -> dict | None:
    """Map a Claude Code tool call onto Palivane's MCP-activity shape (POST /api/ingest/mcp).

    MCP tools (mcp__<server>__<tool>) carry their server name so the org allowlist
    applies; built-in tools send server="" — they aren't MCP servers, so the
    untrusted-server policy signal must not fire for them. transport=stdio matches how
    the backend already keys local (non-network) agent activity."""
    if not tool_name or tool_name in SKIP_TOOLS:
        return None
    if not isinstance(tool_input, dict):
        tool_input = {}

    activity = {"method": "tools/call", "server": "", "tool": tool_name,
                "args_text": "", "resource": "", "transport": "stdio"}

    if tool_name.startswith("mcp__"):
        parts = tool_name.split("__", 2)  # mcp__<server>__<tool>; tool may contain __
        activity["server"] = parts[1] if len(parts) > 1 else ""
        activity["tool"] = parts[2] if len(parts) > 2 else ""
        harvested: list[str] = []
        _harvest_strings(tool_input, harvested)
        activity["args_text"] = "\n".join(harvested)[:_MAX_ARGS_TEXT]
    elif tool_name == "Bash":
        cmd = tool_input.get("command", "")
        desc = tool_input.get("description", "")
        activity["args_text"] = "\n".join(p for p in (cmd, desc) if isinstance(p, str) and p)[:_MAX_ARGS_TEXT]
    elif tool_name == "Read":
        activity["method"] = "resources/read"
        fp = tool_input.get("file_path", "")
        activity["resource"] = fp if isinstance(fp, str) else ""
    else:
        # Write/Edit/WebFetch/… — harvest all string values; content is scanned for
        # secrets/PII. The FILE PATH is lifted out into `resource` rather than left in
        # args_text: the backend judges "targets a sensitive path" on resource for these
        # tools, because their args_text is the file's content and a document that merely
        # mentions ~/.aws/credentials is not an access of it.
        fp = tool_input.get("file_path") or tool_input.get("notebook_path") or ""
        if isinstance(fp, str):
            activity["resource"] = fp
        harvested = []
        _harvest_strings(tool_input, harvested)
        activity["args_text"] = "\n".join(harvested)[:_MAX_ARGS_TEXT]
    return activity


def prompt_parse_miss(event: dict) -> bool:
    """True when a UserPromptSubmit carries no `prompt` STRING at all.

    The distinction that matters: an empty prompt is a user who submitted nothing, and is
    silence we should keep. A missing or non-string field means the contract moved under us
    — the hook still fires, still returns 0, and the heartbeat stays green while every typed
    prompt goes unscanned. That is the failure fail-open cannot tell you about, so it is the
    one we report."""
    return not isinstance(event.get("prompt"), str)


def build_prompt_usage(event: dict) -> dict | None:
    """UserPromptSubmit -> ai-usage payload (the typed prompt on its way to the model)."""
    prompt = event.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        return None
    return {"content": prompt[:_MAX_ARGS_TEXT], "destination": "claude-code", "tool": "claude-code"}


# --- Auth circuit breaker -------------------------------------------------------------
# HTTP 401/403 means THIS token is dead (revoked or invalid) — a permanent signal, so we
# stop calling out on every prompt/tool call. We fingerprint the token, stand down (fail
# open, no network) for _DEAUTH_SECS, and re-probe hourly in case the 401 was transient.
# A fresh token from `palivane connect` has a different fingerprint, so a stale marker never
# suppresses it. Repeated transient errors (timeouts/5xx) trip a shorter cooldown so we
# don't retry-storm an unreachable backend either.
_DEAUTH_SECS = 3600
_COOLDOWN_SECS = 300
_FAIL_THRESHOLD = 3


def _breaker_path() -> str:
    d = os.path.expanduser(os.getenv("PALIVANE_STATE_DIR", "~/.palivane"))
    return os.path.join(d, "hook-breaker.json")


def _token_fp(token: str) -> str:
    return hashlib.sha256((token or "").encode()).hexdigest()[:16]


def _breaker_load() -> dict:
    try:
        with open(_breaker_path()) as fh:
            st = json.load(fh)
        return st if isinstance(st, dict) else {}
    except Exception:
        return {}


def _breaker_save(state: dict) -> None:
    # A unique temp name per write: concurrent writers sharing the state dir used to share
    # one fixed "<path>.tmp" and clobber each other mid-write.
    try:
        path = _breaker_path()
        d = os.path.dirname(path)
        os.makedirs(d, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".hook-breaker.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as fh:
                json.dump(state, fh)
            os.replace(tmp, path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
    except Exception:
        pass


def _deadline(v, now: float, cap: float) -> float:
    """A breaker deadline read from the state file, which anything running as this user can
    write. Only a finite positive number no further out than now+cap counts — every deadline
    this code writes is at most `cap` away, so anything beyond it (a hand-written 9e18 that
    would stand the sensor down forever) is tampering or clock skew: treat it as closed."""
    if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) or v <= 0:
        return 0.0
    return float(v) if v <= now + cap else 0.0


def _breaker_skip(token: str) -> str:
    """Reason to skip the network and fail open, or '' to proceed."""
    st, fp, now = _breaker_load(), _token_fp(token), time.time()
    if st.get("deauth_fp") == fp and now < _deadline(st.get("deauth_until"), now, _DEAUTH_SECS):
        return "deauthorized"
    if now < _deadline(st.get("cooldown_until"), now, _COOLDOWN_SECS):
        return "backoff"
    return ""


def _breaker_record(token: str, status) -> None:
    """status: 200 healthy | 401/403 revoked | None transient error."""
    st, fp, now = _breaker_load(), _token_fp(token), time.time()
    if status == 200:
        if st:
            _breaker_save({})                       # healthy — clear breaker state
        return
    if status in (401, 403):
        first = st.get("deauth_fp") != fp
        _breaker_save({"deauth_fp": fp, "deauth_until": now + _DEAUTH_SECS})
        if first:
            sys.stderr.write("palivane: capture key rejected (revoked or invalid) — standing "
                             "down; re-run `palivane connect` to re-issue.\n")
        return
    prev = st.get("fails")
    fails = (prev if isinstance(prev, int) and not isinstance(prev, bool) and prev > 0 else 0) + 1
    if fails >= _FAIL_THRESHOLD:
        st.update(fails=0, cooldown_until=now + _COOLDOWN_SECS)
    else:
        st["fails"] = fails
    _breaker_save(st)


# --- Scan-failed ledger (SEC-01) --------------------------------------------------------
# Every scan error still fails open: Palivane being unreachable never blocks the user. What
# changed is that a failed scan is no longer folded silently into "allow". Each one is
# counted here (how many, first and last time, a reason from a fixed vocabulary, never any
# content) and the tally rides along on the next request that reaches the backend, which
# adds it to this sensor's heartbeat. The console's Fleet view then says "N scans failed
# open since T, reason X" instead of showing a healthy, quiet sensor. No extra request is
# ever made for it, and the happy path pays one rename that finds no file.
#
# Claim-by-rename keeps concurrent runs from reporting the same tally twice: a sender
# atomically renames the pending file to a private claim and attaches it, then deletes the
# claim once the backend accepted the request or folds it back in when the request failed.
# A claim left behind by a killed process is folded back by the next failure. Counting is a
# read-modify-write under a lock (threads) with an atomic replace (processes), so two
# processes failing at the same instant can drop a count, and a request the backend took but
# never answered is counted again: off by one at the edges, never by an episode. If the
# backend stays unreachable nothing is delivered, and the sensor's
# last-seen ages into the console's stale/dark buckets and the gone-dark alert instead.
# Copied in every hook and the proxy (each is a standalone file); keep the copies identical
# apart from _FAILOPEN_FILE.
_FAILOPEN_FILE = "scan-failed-claude-code.json"
_FAILOPEN_REASONS = ("timeout", "network", "server-error", "auth-rejected", "rate-limited",
                     "http-error", "bad-response", "breaker-open", "error", "update-failed")
_FAILOPEN_MAX = 1000000
_FAILOPEN_ORPHAN_SECS = 120
_FAILOPEN_LOCK = threading.Lock()


def _failopen_path() -> str:
    d = os.path.expanduser(os.getenv("PALIVANE_STATE_DIR", "~/.palivane"))
    return os.path.join(d, _FAILOPEN_FILE)


def failure_reason(exc) -> str:
    """Bucket a failed scan into the fixed reason vocabulary. Never the error's text: that
    can quote a URL or a server message, and the report must carry nothing but counts."""
    if isinstance(exc, str):
        return exc if exc in _FAILOPEN_REASONS else "error"
    if isinstance(exc, urllib.error.HTTPError):
        code = exc.code if isinstance(exc.code, int) else 0
        if code in (401, 403):
            return "auth-rejected"
        if code == 429:
            return "rate-limited"
        return "server-error" if code >= 500 else "http-error"
    if isinstance(exc, (TimeoutError, socket.timeout)) or isinstance(
            getattr(exc, "reason", None), (TimeoutError, socket.timeout)):
        return "timeout"
    if isinstance(exc, OSError):
        return "network"
    if isinstance(exc, ValueError):
        return "bad-response"
    return "error"


def _failopen_clean(st) -> dict:
    """Only well-formed fields survive: the file is writable by anything running as this
    user, so a known reason with a positive int count, and finite positive timestamps."""
    if not isinstance(st, dict):
        return {}
    reasons = {}
    raw = st.get("reasons")
    if isinstance(raw, dict):
        for k, v in raw.items():
            if k in _FAILOPEN_REASONS and isinstance(v, int) and not isinstance(v, bool) and v > 0:
                reasons[k] = min(v, _FAILOPEN_MAX)
    if not reasons:
        return {}
    out = {"count": min(sum(reasons.values()), _FAILOPEN_MAX), "reasons": reasons}
    for k in ("first", "last"):
        v = st.get(k)
        if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) and v > 0:
            out[k] = int(v)
    return out


def _failopen_merge(a: dict, b: dict) -> dict:
    reasons = dict(a.get("reasons") or {})
    for k, v in (b.get("reasons") or {}).items():
        reasons[k] = reasons.get(k, 0) + v
    firsts = [x["first"] for x in (a, b) if "first" in x]
    lasts = [x["last"] for x in (a, b) if "last" in x]
    return _failopen_clean({"reasons": reasons, "first": min(firsts) if firsts else None,
                            "last": max(lasts) if lasts else None})


def _failopen_read(path: str) -> dict:
    try:
        with open(path) as fh:
            return _failopen_clean(json.load(fh))
    except Exception:
        return {}


def _failopen_write(path: str, st: dict) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".scan-failed.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(st, fh)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def record_scan_failure(reason, claim: str = "") -> None:
    """Count one scan that failed open (`reason`: the exception, or a vocabulary word),
    and fold back an undelivered claim plus any claim a killed process left behind. Runs
    only on the failure path. Never raises."""
    try:
        with _FAILOPEN_LOCK:
            path, now = _failopen_path(), int(time.time())
            back = [claim] if claim else []
            d, prefix = os.path.dirname(path), "." + _FAILOPEN_FILE + ".claim."
            try:
                for name in os.listdir(d):
                    p = os.path.join(d, name)
                    if (name.startswith(prefix) and p != claim
                            and time.time() - os.path.getmtime(p) > _FAILOPEN_ORPHAN_SECS):
                        back.append(p)
            except OSError:
                pass
            st = _failopen_read(path)
            for p in back:
                st = _failopen_merge(st, _failopen_read(p))
            st = _failopen_merge(st, {"reasons": {failure_reason(reason): 1},
                                      "first": now, "last": now})
            _failopen_write(path, st)
            for p in back:
                try:
                    os.unlink(p)
                except OSError:
                    pass
    except Exception:
        pass


def claim_scan_failures() -> tuple:
    """Take the pending tally for the request about to be sent: (claim path, report), or
    ("", {}) when nothing is pending, which costs one rename that finds no file. The report
    is counts, reasons and two timestamps; nothing else is ever in it."""
    try:
        path = _failopen_path()
        claim = os.path.join(os.path.dirname(path), "." + _FAILOPEN_FILE + ".claim."
                             + str(os.getpid()) + "." + os.urandom(4).hex())
        os.rename(path, claim)
    except Exception:
        return "", {}
    try:
        os.utime(claim)          # a fresh claim, so the orphan sweep leaves it alone
    except OSError:
        pass
    report = _failopen_read(claim)
    if not report:
        scan_failures_delivered(claim)
        return "", {}
    return claim, report


def scan_failures_delivered(claim: str) -> None:
    """The backend accepted the request that carried this claim: drop it."""
    if claim:
        try:
            os.unlink(claim)
        except OSError:
            pass


def scan(endpoint: str, payload: dict, url: str, token: str,
         user: str = "", timeout: float = 5.0, ua: str = "") -> dict:
    """Call a Palivane ingest endpoint; fail open (action=allow) on any error. A revoked key
    trips the circuit breaker so we stop hammering the backend on every call. Every
    fail-open is counted in the scan-failed ledger, and the pending tally rides on this
    request when there is one."""
    skip = _breaker_skip(token)
    if skip:
        record_scan_failure("auth-rejected" if skip == "deauthorized" else "breaker-open")
        return {"action": "allow", "reason": f"scan-skipped:{skip}"}
    claim, report = claim_scan_failures()
    try:
        body = dict(payload)
        body["user"] = user
        if report:
            body["scan_failed"] = report
        req = urllib.request.Request(
            url.rstrip("/") + endpoint, method="POST",
            data=json.dumps(body).encode(),
            headers={"content-type": "application/json", "User-Agent": ua or agent_ua(), "X-Palivane-Token": token},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read()
    except urllib.error.HTTPError as e:
        _breaker_record(token, e.code)
        record_scan_failure(e, claim)
        return {"action": "allow", "reason": f"scan-failed:{e.code}"}
    except Exception as e:
        _breaker_record(token, None)
        record_scan_failure(e, claim)
        return {"action": "allow", "reason": "scan-failed"}
    scan_failures_delivered(claim)          # the backend took the request, and the tally
    try:
        out = json.loads(raw)
    except Exception as e:
        _breaker_record(token, None)
        record_scan_failure(e)
        return {"action": "allow", "reason": "scan-failed"}
    _breaker_record(token, 200)
    return out


def report_parse_miss(endpoint: str, tool: str, cfg: dict, event: dict) -> None:
    """Tell the backend the extractor recognised an event and got nothing out of it.

    The content field carries a marker rather than being empty — the ingest schema requires
    a non-empty body, and the proxy already reports drift this way ("[comet parse-miss] ").
    It is never scored: the endpoint short-circuits on the flag.

    Deliberately cheap and deliberately silent: a short timeout, failure ignored, no output
    to the host. It exists to move one counter on the sensor heartbeat, which is what turns
    "this device is quiet" into "this device has been blind since claude-code 2.1.4"."""
    if not cfg.get("url") or not cfg.get("token"):
        return
    try:
        body = ({"method": "tools/call", "tool": tool, "transport": "stdio",
                 "parse_miss": True} if endpoint.endswith("/mcp")
                else {"content": "[palivane parse-miss]", "tool": tool, "destination": tool,
                       "parse_miss": True})
        scan(endpoint, body, cfg["url"], cfg["token"], cfg.get("user", ""),
             min(cfg.get("timeout", 5.0), 3.0), ua=agent_ua(event))
    except Exception:
        pass


def scan_mcp(activity: dict, url: str, token: str, user: str = "", timeout: float = 5.0) -> dict:
    """Call the Palivane MCP ingest endpoint; fail open (action=allow) on any error."""
    return scan("/api/ingest/mcp", activity, url, token, user, timeout)


def _auth_rejected(verdict: dict) -> bool:
    """True when this verdict is a fail-open caused by the backend REFUSING our key.

    Distinct from a transient network failure: a rejected key means governance is off for
    this machine until someone re-connects, and nothing else will say so. The stderr notice
    in _breaker_record is invisible in practice — hosts (Claude Code among them) discard a
    hook's stderr unless it exits non-zero — so main() turns this into a non-zero exit,
    which surfaces as a NON-BLOCKING hook error. The tool call still proceeds either way.
    """
    return str(verdict.get("reason", "")).startswith(("scan-failed:401", "scan-failed:403"))


# --- The server's enforce stance, remembered between runs (#278) ------------------------
# Tool calls are scanned inline only under enforce. Otherwise a detached child reports them
# and nothing reads the verdict. PALIVANE_ENFORCE is the device's own stance, but the org can
# also enforce THIS actor from the console (Settings → Enforcement, or a per-user policy
# override), and the hook learns that only from the `enforce` field of an inline verdict.
# Prompts are scanned inline even in monitor mode, so each prompt verdict is a fresh reading:
# it is remembered here, and tool calls scan inline while it says enforce.
#
# The bit only chooses inline over detached. It never blocks anything by itself: the inline
# verdict decides, with its own live `enforce`. A stale or forged file costs latency at
# worst, and a missing one is plain monitor mode. The TTL lets a revoked override lapse even
# when no prompt comes along to clear it; a prompt verdict that says monitor clears it at
# once. It is keyed to the backend, key and user, so reconnecting as someone else never
# inherits it. Copied in palivane-hook, -cursor-hook, -codex-hook and -gemini-hook (each is
# a standalone file); keep the copies identical apart from _ENFORCE_FILE.
_ENFORCE_TTL = 3600
_ENFORCE_FILE = "enforce-claude-code.json"


def _enforce_path() -> str:
    d = os.path.expanduser(os.getenv("PALIVANE_STATE_DIR", "~/.palivane"))
    return os.path.join(d, _ENFORCE_FILE)


def _enforce_key(cfg: dict) -> str:
    ident = "\n".join(str(cfg.get(k) or "") for k in ("url", "token", "user"))
    return hashlib.sha256(ident.encode()).hexdigest()[:16]


def remember_enforce(verdict: dict, cfg: dict, authoritative: bool) -> None:
    """Record the server's enforce stance from an inline verdict. A prompt verdict is
    `authoritative`: it sets or clears the bit. A tool-call verdict only refreshes a set bit,
    which keeps a long unattended run inline past the TTL. Its False does not clear, because
    a monitor override on one tool says nothing about the others. A fail-open verdict
    carries no `enforce` and changes nothing. Never raises."""
    v = verdict.get("enforce") if isinstance(verdict, dict) else None
    if not isinstance(v, bool) or not (v or authoritative):
        return
    try:
        path = _enforce_path()
        if not v:
            if os.path.exists(path):
                os.unlink(path)
            return
        d = os.path.dirname(path)
        os.makedirs(d, exist_ok=True)
        # A unique temp name per write, then an atomic rename: concurrent hook runs never
        # see a half-written file.
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".enforce.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as fh:
                json.dump({"key": _enforce_key(cfg), "until": time.time() + _ENFORCE_TTL}, fh)
            os.replace(tmp, path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
    except Exception:
        pass


def server_enforced(cfg: dict) -> bool:
    """True while the last server verdict for this backend, key and user said enforce and is
    younger than _ENFORCE_TTL. An `until` further out than the TTL is not one this code wrote
    (or the clock moved), so it does not count. Any error is False: plain monitor mode."""
    try:
        with open(_enforce_path()) as fh:
            st = json.load(fh)
        until, now = st.get("until"), time.time()
        if isinstance(until, bool) or not isinstance(until, (int, float)) or not math.isfinite(until):
            return False
        return st.get("key") == _enforce_key(cfg) and now < until <= now + _ENFORCE_TTL
    except Exception:
        return False


def should_block(verdict: dict, enforce: bool) -> bool:
    """Mirror of the proxy's rule: a confirmed secret/PII leak (force_block) is blocked
    even in monitor mode — block the certain, monitor the fuzzy. Everything else blocks
    under enforce — local (PALIVANE_ENFORCE) or the org's stance from the console
    (Settings → Enforcement), which the server returns on every verdict."""
    if verdict.get("force_block"):
        return True
    return (enforce or bool(verdict.get("enforce"))) and verdict.get("action") == "block"


def deny_output(verdict: dict) -> dict:
    """PreToolUse structured deny — the reason is fed back to the model."""
    cats = ", ".join(dict.fromkeys(
        s.get("category", "") for s in verdict.get("signals", []) if s.get("category")))
    reason = (f"Blocked by Palivane: risky tool call ({cats or 'policy'}) — "
              f"risk {verdict.get('risk_score', 0)}/{verdict.get('severity', 'high')}.")
    return {"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}


# Events whose answer may be "ask". UserPromptSubmit can only block.
_ASK_EVENTS = frozenset({"PreToolUse"})


def should_ask(event_name: str, verdict: dict) -> bool:
    """The org's ASK verdict: a tool call in the warn band that the org wants a person to
    approve rather than run silently. The server decides (it sets `ask` only for an enforced
    actor in a tenant that opted in), so this honors it on the events that can carry one.
    Callers check should_block first: a block is never softened into an ask. The same rule
    is copied in every hook; only _ASK_EVENTS differs."""
    return event_name in _ASK_EVENTS and bool(verdict.get("ask"))


def _ask_message(verdict: dict) -> str:
    """The question put to the developer. The reader is the user, so it carries the fix."""
    cats = ", ".join(dict.fromkeys(
        s.get("category", "") for s in verdict.get("signals", []) if s.get("category")))
    msg = (f"Palivane flagged this tool call ({cats or 'policy'}) — "
           f"risk {verdict.get('risk_score', 0)}/{verdict.get('severity', 'suspicious')}. "
           f"Approve it only if you meant to run it.")
    fixes = verdict.get("remediation") or []
    if fixes:
        msg += "\nHow to fix:\n" + "\n".join(f"  • {f}" for f in fixes[:4])
    return msg


def ask_output(verdict: dict) -> dict:
    """PreToolUse ask — Claude Code shows its normal permission prompt and the developer
    approves or refuses. The reason is shown to the USER in that prompt (a deny's goes to the
    model). In a run nobody can answer (`claude -p`), Claude Code denies the call instead."""
    return {"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "ask",
        "permissionDecisionReason": _ask_message(verdict),
    }}


def _shown_evidence(evidence: str) -> str:
    """A signal's evidence, safe for the transcript. Known formats are a label ("AWS access
    key id") and pass through; a format-less token comes as its first 10 characters plus
    "…", which is cut to 4 here: enough to find it in the prompt, not a quarter of the key."""
    parts = [p.strip() for p in evidence.split(",") if p.strip()]
    return ", ".join(p[:4] + "…" if p.endswith("…") else p for p in parts)[:80]


def _what_matched(verdict: dict, limit: int = 3) -> list[str]:
    """The strongest few signals as "what" lines, so the user knows what to take out of the
    prompt instead of only its category. Ranked like the server's top_signals."""
    def strength(s: dict) -> float:
        try:
            return float(s.get("weight", 0) or 0) * float(s.get("confidence", 1) or 0)
        except (TypeError, ValueError):
            return 0.0
    lines: list[str] = []
    for s in sorted((s for s in verdict.get("signals", []) if isinstance(s, dict)),
                    key=strength, reverse=True):
        what = _shown_evidence(str(s.get("evidence") or "")) or (s.get("title") or "").strip()
        if what and what not in lines:
            lines.append(what)
        if len(lines) == limit:
            break
    return lines


def prompt_block_output(verdict: dict) -> dict:
    """UserPromptSubmit structured block — the prompt is erased and the reason (with what
    matched and the fix, since the reader here is the user, not the model) is shown in the
    transcript."""
    cats = ", ".join(dict.fromkeys(
        s.get("category", "") for s in verdict.get("signals", []) if s.get("category")))
    reason = (f"Blocked by Palivane: {cats or 'policy'} in your prompt — "
              f"risk {verdict.get('risk_score', 0)}/{verdict.get('severity', 'high')}. "
              f"The prompt was not sent.")
    matched = _what_matched(verdict)
    if matched:
        reason += "\nFound:\n" + "\n".join(f"  • {m}" for m in matched)
    fixes = verdict.get("remediation") or []
    if fixes:
        reason += "\nHow to fix:\n" + "\n".join(f"  • {f}" for f in fixes[:4])
    # suppressOriginalPrompt: by default Claude Code ends the block message with
    # "Original prompt: <the text>" and writes that message to the session transcript, so
    # the secret we just stopped was shown again and put on disk. Checked against Claude
    # Code 2.1.309: with it the line is gone and the prompt is still blocked.
    return {"decision": "block", "reason": reason,
            "hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                   "suppressOriginalPrompt": True}}


# --- justified proceed (Human Firewall, CLI edition) ---------------------------------------
# A blocked prompt writes a pending-block record; `palivane-hook justify "reason"` records
# the business justification with the backend and stores the returned override token; the
# next submission of the SAME prompt attaches it and goes through (audit-logged). Mirrors
# the browser extension's flow — confirmed credentials stay non-overridable server-side.

def _state_path(name: str) -> str:
    d = os.path.expanduser(os.getenv("PALIVANE_STATE_DIR", "~/.palivane"))
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, name)


def _save_last_block(content: str, verdict: dict) -> None:
    import hashlib
    try:
        with open(_state_path("last-block.json"), "w") as f:
            json.dump({"finding_id": verdict.get("finding_id"),
                       "content_hash": hashlib.sha256(content.encode()).hexdigest(),
                       "at": time.time()}, f)
    except OSError:
        pass


def _load_override_token() -> str:
    try:
        with open(_state_path("override-token.json")) as f:
            blob = json.load(f)
        if blob.get("expires", 0) > time.time():
            return str(blob.get("token") or "")
    except (OSError, ValueError):
        pass
    return ""


def _clear_override_token() -> None:
    try:
        os.unlink(_state_path("override-token.json"))
    except OSError:
        pass


def cmd_justify(reason: str) -> int:
    """`palivane-hook justify "reason"` — record a business justification for the last
    blocked prompt and unlock resending it once."""
    cfg = read_config()
    if not cfg["url"] or not cfg["token"]:
        print("palivane: not connected (no backend url/token).", file=sys.stderr)
        return 1
    try:
        with open(_state_path("last-block.json")) as f:
            last = json.load(f)
    except (OSError, ValueError):
        print("palivane: no blocked prompt on record — nothing to justify.", file=sys.stderr)
        return 1
    if not last.get("finding_id"):
        print("palivane: the last block carried no finding id.", file=sys.stderr)
        return 1
    req = urllib.request.Request(
        cfg["url"].rstrip("/") + "/api/ingest/justify", method="POST",
        data=json.dumps({"finding_id": last["finding_id"], "justification": reason,
                         "content_hash": last.get("content_hash", ""),
                         "user": cfg["user"]}).encode(),
        headers={"content-type": "application/json",
                 "User-Agent": f"palivane-hook/{VERSION}",
                 "X-Palivane-Token": cfg["token"]})
    try:
        with urllib.request.urlopen(req, timeout=cfg["timeout"]) as r:
            out = json.loads(r.read())
    except urllib.error.HTTPError as e:
        if e.code == 403:
            print("palivane: not self-overridable (confirmed credential, or the org has "
                  "justified-proceed off) — use Request exception in the console.",
                  file=sys.stderr)
        else:
            print(f"palivane: justify failed (HTTP {e.code}).", file=sys.stderr)
        return 1
    except Exception:
        print("palivane: justify failed (backend unreachable).", file=sys.stderr)
        return 1
    try:
        with open(_state_path("override-token.json"), "w") as f:
            json.dump({"token": out.get("override_token", ""),
                       "expires": time.time() + int(out.get("expires_in", 600)) - 30}, f)
    except OSError:
        pass
    print("palivane: justification recorded — resubmit the same prompt to send it.")
    return 0


def _send_detached(endpoint: str, payload: dict, cfg: dict) -> None:
    """Report in a detached child so the hook returns instantly (monitor mode)."""
    p = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--send"],
        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    p.stdin.write(json.dumps({
        "endpoint": endpoint, "payload": payload, "url": cfg["url"],
        "token": cfg["token"], "user": cfg["user"], "timeout": cfg["timeout"],
    }).encode())
    p.stdin.close()


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "justify":
        reason = " ".join(sys.argv[2:]).strip()
        if len(reason) < 10:
            print("usage: palivane-hook justify \"why this needs to go (10+ chars)\"",
                  file=sys.stderr)
            return 1
        return cmd_justify(reason)
    if "--send" in sys.argv[1:]:
        # Worker mode (spawned by the monitor path): post the report and exit.
        try:
            job = json.load(sys.stdin)
            scan(job.get("endpoint", "/api/ingest/mcp"), job["payload"], job["url"],
                 job["token"], job.get("user", ""), float(job.get("timeout", 5)))
        except Exception:
            pass
        return 0

    try:
        event = json.load(sys.stdin)
    except Exception:
        return 0

    cfg = read_config()
    # Skip inspection entirely inside an excluded working directory (e.g. the Palivane repo).
    if _is_excluded(event.get("cwd") or "", cfg["exclude"]):
        return 0

    if event.get("hook_event_name") == "UserPromptSubmit":
        payload = build_prompt_usage(event)
        if payload is None:
            if prompt_parse_miss(event):
                report_parse_miss("/api/ingest/ai-usage", "claude-code", cfg, event)
            return 0
        if not cfg["url"] or not cfg["token"]:
            return 0  # not connected to Palivane — nothing to report to
        # Prompts are always scanned inline (even in monitor mode): a confirmed
        # secret/PII leak (force_block) must be stopped before it leaves the device.
        grant = _load_override_token()
        if grant:
            payload["override_token"] = grant
        verdict = scan("/api/ingest/ai-usage", payload, cfg["url"], cfg["token"],
                       cfg["user"], cfg["timeout"])
        if verdict.get("overridden"):
            _clear_override_token()               # one grant, one send
        remember_enforce(verdict, cfg, authoritative=True)
        if should_block(verdict, cfg["enforce"]):
            out = prompt_block_output(verdict)
            if verdict.get("self_justify") and verdict.get("finding_id"):
                _save_last_block(payload.get("content", ""), verdict)
                out["reason"] += ("\nBusiness need to send this anyway? Run:\n"
                                  "  palivane-hook justify \"why this needs to go\"\n"
                                  "It is recorded for the security team; then resubmit "
                                  "this exact prompt.")
            print(json.dumps(out))
            # Exit 2 as well as the JSON block. A Claude Code that predates
            # suppressOriginalPrompt may treat the unknown field as invalid JSON, and on
            # exit 0 invalid JSON is a non-blocking error, so the prompt would go through.
            # Exit 2 blocks either way (stderr is the reason it shows); a current Claude
            # Code still reads the JSON and leaves the prompt text out.
            print(out["reason"], file=sys.stderr)
            return 2
        return 1 if _auth_rejected(verdict) else 0

    # A PreToolUse that carries no tool_name string is the tool-call equivalent of a
    # prompt with no prompt: the contract moved. Scoped to PreToolUse deliberately — any
    # other event reaching here is a config question, not vendor drift, and reporting it
    # would turn this counter into noise.
    if event.get("hook_event_name") == "PreToolUse" and not isinstance(event.get("tool_name"), str):
        report_parse_miss("/api/ingest/mcp", "claude-code", cfg, event)
        return 0

    tool_input = event.get("tool_input") or {}
    if _touches_excluded(tool_input, cfg["exclude"]):
        return 0                                  # the call reaches into an excluded repo

    activity = build_activity(event.get("tool_name", ""), tool_input)
    if activity is None:
        return 0

    if not cfg["url"] or not cfg["token"]:
        return 0  # not connected to Palivane — nothing to report to

    # Inline under enforce: the device's own (PALIVANE_ENFORCE), or the server's as last
    # reported (the console's org stance or a per-user override, #278). Otherwise monitor
    # mode stays zero-latency: a detached child posts the report.
    if cfg["enforce"] or server_enforced(cfg):
        verdict = scan_mcp(activity, cfg["url"], cfg["token"], cfg["user"], cfg["timeout"])
        remember_enforce(verdict, cfg, authoritative=False)
        if should_block(verdict, cfg["enforce"]):
            print(json.dumps(deny_output(verdict)))
            return 0
        if should_ask("PreToolUse", verdict):
            print(json.dumps(ask_output(verdict)))
            return 0
        return 1 if _auth_rejected(verdict) else 0
    _send_detached("/api/ingest/mcp", activity, cfg)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # fail open — never break the developer's session
