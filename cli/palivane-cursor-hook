#!/usr/bin/env python3
"""palivane-cursor-hook — Cursor agent-hook adapter: local, pre-execution inspection.

Cursor's model/chat endpoint pins its certificate, so the egress proxy can't read its
prompts, and Cursor ignores OPENAI_BASE_URL, so the gateway can't be interposed either.
This hook closes that gap from *inside* Cursor using its Hooks API (Cursor 1.7+): Cursor
runs it at agent-lifecycle events, passing structured JSON on stdin, and honors a JSON
verdict on stdout. Because it runs locally, it is immune to the cert pinning.

One script handles every event, dispatched on `hook_event_name`:

  beforeSubmitPrompt   -> the user's prompt (+ attachments)  -> /api/ingest/ai-usage
                          (shadow-AI / data-loss on what's about to leave — the piece the
                          proxy can't see because Cursor pins its cert)
  beforeShellExecution -> shell command                       -> /api/ingest/mcp (tool=shell)
  beforeMCPExecution   -> MCP tool call (server/tool/args)    -> /api/ingest/mcp
  beforeReadFile       -> file pulled into context (+content) -> /api/ingest/mcp (resources/read)
  afterFileEdit        -> written content (secrets/PII)       -> /api/ingest/mcp (monitor-only;
                          Cursor supports no output for this event)

Monitor by default: tool-surface verdicts are recorded by a detached child and the action
is allowed with ~zero added latency. Prompts (beforeSubmitPrompt) are the exception: they
are scanned inline even in monitor mode so a confirmed secret/PII leak (`force_block`) is
stopped before it leaves — same rule as the egress proxy: block the certain, monitor the
fuzzy. Set PALIVANE_ENFORCE=true to scan every event synchronously and DENY on a block
verdict — the reason is surfaced to the user and the agent. The same happens while the
server last said this actor is enforced (the `enforce` field of a prompt verdict, set by
the console's org stance or a per-user override; remembered for an hour under
~/.palivane). An org that turned on ASK
(console Settings → Policy) also has a shell or MCP call in the warn band put to the
developer as Cursor's own approval prompt instead of running silently; a block stays a
block. Fails open on any error: Palivane being down never breaks the developer.

Register in ~/.cursor/hooks.json (user), <project>/.cursor/hooks.json, or the enterprise
path pushed by MDM (macOS /Library/Application Support/Cursor/hooks.json, Linux
/etc/cursor/hooks.json, Windows C:\\ProgramData\\Cursor\\hooks.json):

  {"version": 1, "hooks": {
     "beforeSubmitPrompt":   [{"command": "/usr/local/bin/palivane-cursor-hook"}],
     "beforeShellExecution": [{"command": "/usr/local/bin/palivane-cursor-hook"}],
     "beforeMCPExecution":   [{"command": "/usr/local/bin/palivane-cursor-hook"}],
     "beforeReadFile":       [{"command": "/usr/local/bin/palivane-cursor-hook"}],
     "afterFileEdit":        [{"command": "/usr/local/bin/palivane-cursor-hook"}]}}

Config: PALIVANE_URL + PALIVANE_TOKEN (an ak_… key) from the environment, else from
~/.cursor/palivane.json ({"url","token","enforce"}), else the gateway pair in
~/.claude/settings.json (if palivane-connect already ran there). Stdlib only.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import re
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request


# Reported in the User-Agent so the console can inventory client builds per device.
VERSION = "1.3.4"


_VER_RE = re.compile(r"^[A-Za-z0-9._+-]{1,24}$")


def agent_ua(event: dict | None = None) -> str:
    """Our User-Agent with the HOST agent's build in a parenthetical, e.g.
    "palivane-cursor-hook/1.0 (cursor/1.2.3)". The console already inventories our build; this
    says which vendor build was live when a shape changed under us. Reported without a
    version when the host does not expose one — never guessed."""
    ver = ""
    if isinstance(event, dict):
        v = event.get("version") or event.get("cli_version")
        if isinstance(v, str) and _VER_RE.match(v):
            ver = v
    return f"palivane-cursor-hook/{VERSION} (cursor{'/' + ver if ver else ''})"


def report_parse_miss(event: dict, cfg: dict) -> None:
    """Tell the backend the extractor recognised a prompt event and got nothing out of it.

    The content field carries a marker rather than being empty (the ingest schema requires a
    non-empty body) and is never scored: the endpoint short-circuits on the flag. The User-Agent
    carries Cursor's own build when the event exposes one, because "since which release" is the
    first question when a shape changes under us. Cheap and silent: a short timeout, no output
    to the host, and nothing at all when the device is not connected."""
    if not cfg.get("url") or not cfg.get("token"):
        return
    _post("/api/ingest/ai-usage",
          {"content": "[palivane parse-miss]", "tool": "cursor", "destination": "cursor",
           "parse_miss": True},
          {**cfg, "timeout": min(cfg.get("timeout", 5.0), 3.0)}, ua=agent_ua(event))


def prompt_parse_miss(event: dict) -> bool:
    """True when the prompt-bearing event carries no `prompt` STRING at all.

    An empty prompt is a user who sent nothing. A missing field means the contract moved:
    the hook still fires and still returns 0, so the heartbeat stays green while every
    prompt goes unscanned. Fail-open cannot tell you about that; this can."""
    return not isinstance(event.get("prompt"), str)
_MAX_ARGS_TEXT = 20000
# Attachment contents ride with the prompt (beforeSubmitPrompt), up to the server's content
# limit. Per file: no more than _MAX_ATTACH_FILE is read, and only text (no NUL bytes).
_MAX_PROMPT_TEXT = 200_000
_MAX_ATTACH_FILE = 256 * 1024

# Events that expect a permission verdict ({"permission": allow|deny|ask}); the odd ones
# out are beforeSubmitPrompt (uses {"continue": bool}) and afterFileEdit (no output).
_PERMISSION_EVENTS = {"beforeShellExecution", "beforeMCPExecution", "beforeReadFile"}

# The ones of those that may answer "ask". beforeReadFile takes allow|deny only, and Cursor
# blocks the action on a response outside the hook's schema, so an ask there would be a
# hard block, not a prompt.
_ASK_EVENTS = frozenset({"beforeShellExecution", "beforeMCPExecution"})


def _harvest_strings(obj, out: list[str]) -> None:
    """Recursively collect string *values* from an arbitrary JSON structure (dict keys
    ignored) — scans unknown tool-input shapes without a per-tool parser."""
    if isinstance(obj, str):
        if len(obj) >= 2:
            out.append(obj)
    elif isinstance(obj, dict):
        for v in obj.values():
            _harvest_strings(v, out)
    elif isinstance(obj, list):
        for v in obj:
            _harvest_strings(v, out)


def _cap(text: str) -> str:
    return text[:_MAX_ARGS_TEXT]


def _server_from_mcp(event: dict) -> str:
    """Best-effort MCP server id from a beforeMCPExecution payload: the URL host for a
    remote server, the command's basename for a stdio server, else the tool-name prefix."""
    url = event.get("url")
    if isinstance(url, str) and url:
        host = urllib.parse.urlparse(url).hostname
        if host:
            return host
    cmd = event.get("command")
    if isinstance(cmd, str) and cmd:
        first = cmd.split()[0] if cmd.split() else cmd
        return os.path.basename(first)
    name = event.get("tool_name", "")
    if isinstance(name, str) and "_" in name:
        # e.g. "mcp_github_create_issue" -> "github"
        parts = name.split("_")
        return parts[1] if parts[0] == "mcp" and len(parts) > 1 else parts[0]
    return ""


def _attachment_text(path: str, roots: list) -> str:
    """An attached file's text, or "" when it can't (or shouldn't) be read: not a regular
    file, bigger than _MAX_ATTACH_FILE, binary, or unreadable. Relative paths resolve against
    the event's workspace roots. Never raises: a prompt must not fail on its attachments."""
    candidates = [path] if os.path.isabs(path) else [os.path.join(r, path) for r in roots]
    for cand in candidates:
        try:
            full = os.path.realpath(os.path.expanduser(cand))
            if not os.path.isfile(full) or os.path.getsize(full) > _MAX_ATTACH_FILE:
                continue
            with open(full, "rb") as f:
                data = f.read(_MAX_ATTACH_FILE + 1)
        except (OSError, ValueError):
            continue
        if b"\0" in data[:8192]:
            return ""                       # binary: the path is all there is to scan
        return data.decode("utf-8", "replace")
    return ""


def build_ai_usage(event: dict) -> dict | None:
    """beforeSubmitPrompt -> ai-usage payload: the prompt, each attachment's path, and the
    attached files' text. Cursor sends attachments as paths, so the files themselves (an
    .env, a config with a key in it) used to go to the model unscanned."""
    prompt = event.get("prompt")
    parts: list[str] = []
    if isinstance(prompt, str) and prompt:
        parts.append(prompt)
    paths = [att["file_path"] for att in event.get("attachments") or []
             if isinstance(att, dict) and isinstance(att.get("file_path"), str)]
    parts.extend(paths)
    roots = [r for r in (event.get("workspace_roots") or []) if isinstance(r, str)]
    if not roots and isinstance(event.get("cwd"), str):
        roots = [event["cwd"]]
    for path in dict.fromkeys(paths):
        text = _attachment_text(path, roots)
        if text.strip():
            parts.append(f"[attachment {path}]\n{text}")
    content = "\n".join(parts).strip()
    if not content:
        return None
    return {"content": content[:_MAX_PROMPT_TEXT], "destination": "cursor", "tool": "cursor"}


def build_activity(event: dict) -> dict | None:
    """Map a Cursor tool-surface event onto Palivane's MCP-activity shape
    (POST /api/ingest/mcp). Returns None for events with no security surface."""
    name = event.get("hook_event_name", "")
    activity = {"method": "tools/call", "server": "", "tool": "", "args_text": "",
                "resource": "", "transport": "stdio"}

    if name == "beforeShellExecution":
        cmd = event.get("command", "")
        cwd = event.get("cwd", "")
        activity["tool"] = "shell"
        activity["args_text"] = _cap("\n".join(p for p in (cmd, cwd) if isinstance(p, str) and p))
        activity["shell_command"] = _cap(cmd) if isinstance(cmd, str) else ""   # exact, for authz
        return activity if cmd else None

    if name == "beforeMCPExecution":
        activity["server"] = _server_from_mcp(event)
        activity["tool"] = event.get("tool_name", "") if isinstance(event.get("tool_name"), str) else ""
        activity["transport"] = "http" if event.get("url") else "stdio"
        ti = event.get("tool_input", "")
        if isinstance(ti, str):
            activity["args_text"] = _cap(ti)
        else:
            harvested: list[str] = []
            _harvest_strings(ti, harvested)
            activity["args_text"] = _cap("\n".join(harvested))
        return activity

    if name == "beforeReadFile":
        fp = event.get("file_path", "")
        activity["method"] = "resources/read"
        activity["resource"] = fp if isinstance(fp, str) else ""
        # Include the file's content so secrets/PII being pulled into context are scanned.
        content = event.get("content", "")
        if isinstance(content, str) and content:
            activity["args_text"] = _cap(content)
        return activity if activity["resource"] else None

    if name == "afterFileEdit":
        fp = event.get("file_path", "")
        activity["tool"] = "edit"
        activity["resource"] = fp if isinstance(fp, str) else ""
        harvested = []
        for e in event.get("edits") or []:
            if isinstance(e, dict) and isinstance(e.get("new_string"), str):
                harvested.append(e["new_string"])
        activity["args_text"] = _cap("\n".join(harvested))
        return activity if (harvested or activity["resource"]) else None

    return None


def _cursor_config(path: str = "~/.cursor/palivane.json") -> dict:
    try:
        with open(os.path.expanduser(path)) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _claude_settings_env(path: str = "~/.claude/settings.json") -> dict:
    try:
        with open(os.path.expanduser(path)) as f:
            env = json.load(f).get("env")
        return env if isinstance(env, dict) else {}
    except Exception:
        return {}


def read_config() -> dict:
    """Resolve backend URL/token/mode: environment, then ~/.cursor/palivane.json, then the
    gateway pair palivane-connect writes to ~/.claude/settings.json (the ak_ token doubles
    as ingest auth; ANTHROPIC_BASE_URL minus /v1 locates the backend)."""
    cc = _cursor_config()
    url = os.getenv("PALIVANE_URL") or cc.get("url", "")
    token = os.getenv("PALIVANE_TOKEN") or cc.get("token", "")
    enforce_raw = os.getenv("PALIVANE_ENFORCE")
    enforce = (enforce_raw if enforce_raw is not None else str(cc.get("enforce", ""))).lower() in ("1", "true", "yes")
    user = os.getenv("PALIVANE_USER") or cc.get("user", "")

    if not url or not token:
        senv = _claude_settings_env()
        if not token:
            gw = senv.get("ANTHROPIC_AUTH_TOKEN", "")
            if isinstance(gw, str) and gw.startswith("ak_"):
                token = gw
        if not url:
            base = senv.get("ANTHROPIC_BASE_URL", "")
            if isinstance(base, str) and base:
                url = base.rstrip("/")
                if url.endswith("/v1"):
                    url = url[: -len("/v1")]
    try:
        timeout = float(os.getenv("PALIVANE_HOOK_TIMEOUT", "5"))
    except ValueError:
        timeout = 5.0
    # Directories to NOT inspect (e.g. the Palivane repo, whose fixtures look like real secrets)
    # — PALIVANE_HOOK_EXCLUDE_DIRS, os.pathsep- or comma-separated, from env or settings.json env.
    raw_excl = (os.getenv("PALIVANE_HOOK_EXCLUDE_DIRS")
                or _claude_settings_env().get("PALIVANE_HOOK_EXCLUDE_DIRS", ""))
    exclude = [os.path.realpath(os.path.expanduser(p)) for p in
               raw_excl.replace(",", os.pathsep).split(os.pathsep) if p.strip()]
    return {"url": url, "token": token, "enforce": enforce, "timeout": timeout,
            "user": user, "exclude": exclude}


# --- Scan-failed ledger (SEC-01) --------------------------------------------------------
# Every scan error still fails open: Palivane being unreachable never blocks the user. What
# changed is that a failed scan is no longer folded silently into "allow". Each one is
# counted here (how many, first and last time, a reason from a fixed vocabulary, never any
# content) and the tally rides along on the next request that reaches the backend, which
# adds it to this sensor's heartbeat. The console's Fleet view then says "N scans failed
# open since T, reason X" instead of showing a healthy, quiet sensor. No extra request is
# ever made for it, and the happy path pays one rename that finds no file.
#
# Claim-by-rename keeps concurrent runs from reporting the same tally twice: a sender
# atomically renames the pending file to a private claim and attaches it, then deletes the
# claim once the backend accepted the request or folds it back in when the request failed.
# A claim left behind by a killed process is folded back by the next failure. Counting is a
# read-modify-write under a lock (threads) with an atomic replace (processes), so two
# processes failing at the same instant can drop a count, and a request the backend took but
# never answered is counted again: off by one at the edges, never by an episode. If the
# backend stays unreachable nothing is delivered, and the sensor's
# last-seen ages into the console's stale/dark buckets and the gone-dark alert instead.
# Copied in every hook and the proxy (each is a standalone file); keep the copies identical
# apart from _FAILOPEN_FILE.
_FAILOPEN_FILE = "scan-failed-cursor.json"
_FAILOPEN_REASONS = ("timeout", "network", "server-error", "auth-rejected", "rate-limited",
                     "http-error", "bad-response", "breaker-open", "error", "update-failed",
                     "unparsed-prompt")
_FAILOPEN_MAX = 1000000
_FAILOPEN_ORPHAN_SECS = 120
_FAILOPEN_LOCK = threading.Lock()


def _failopen_path() -> str:
    d = os.path.expanduser(os.getenv("PALIVANE_STATE_DIR", "~/.palivane"))
    return os.path.join(d, _FAILOPEN_FILE)


def failure_reason(exc) -> str:
    """Bucket a failed scan into the fixed reason vocabulary. Never the error's text: that
    can quote a URL or a server message, and the report must carry nothing but counts."""
    if isinstance(exc, str):
        return exc if exc in _FAILOPEN_REASONS else "error"
    if isinstance(exc, urllib.error.HTTPError):
        code = exc.code if isinstance(exc.code, int) else 0
        if code in (401, 403):
            return "auth-rejected"
        if code == 429:
            return "rate-limited"
        return "server-error" if code >= 500 else "http-error"
    if isinstance(exc, (TimeoutError, socket.timeout)) or isinstance(
            getattr(exc, "reason", None), (TimeoutError, socket.timeout)):
        return "timeout"
    if isinstance(exc, OSError):
        return "network"
    if isinstance(exc, ValueError):
        return "bad-response"
    return "error"


def _failopen_clean(st) -> dict:
    """Only well-formed fields survive: the file is writable by anything running as this
    user, so a known reason with a positive int count, and finite positive timestamps."""
    if not isinstance(st, dict):
        return {}
    reasons = {}
    raw = st.get("reasons")
    if isinstance(raw, dict):
        for k, v in raw.items():
            if k in _FAILOPEN_REASONS and isinstance(v, int) and not isinstance(v, bool) and v > 0:
                reasons[k] = min(v, _FAILOPEN_MAX)
    if not reasons:
        return {}
    out = {"count": min(sum(reasons.values()), _FAILOPEN_MAX), "reasons": reasons}
    for k in ("first", "last"):
        v = st.get(k)
        if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) and v > 0:
            out[k] = int(v)
    return out


def _failopen_merge(a: dict, b: dict) -> dict:
    reasons = dict(a.get("reasons") or {})
    for k, v in (b.get("reasons") or {}).items():
        reasons[k] = reasons.get(k, 0) + v
    firsts = [x["first"] for x in (a, b) if "first" in x]
    lasts = [x["last"] for x in (a, b) if "last" in x]
    return _failopen_clean({"reasons": reasons, "first": min(firsts) if firsts else None,
                            "last": max(lasts) if lasts else None})


def _failopen_read(path: str) -> dict:
    try:
        with open(path) as fh:
            return _failopen_clean(json.load(fh))
    except Exception:
        return {}


def _failopen_write(path: str, st: dict) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".scan-failed.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(st, fh)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def record_scan_failure(reason, claim: str = "") -> None:
    """Count one scan that failed open (`reason`: the exception, or a vocabulary word),
    and fold back an undelivered claim plus any claim a killed process left behind. Runs
    only on the failure path. Never raises."""
    try:
        with _FAILOPEN_LOCK:
            path, now = _failopen_path(), int(time.time())
            back = [claim] if claim else []
            d, prefix = os.path.dirname(path), "." + _FAILOPEN_FILE + ".claim."
            try:
                for name in os.listdir(d):
                    p = os.path.join(d, name)
                    if (name.startswith(prefix) and p != claim
                            and time.time() - os.path.getmtime(p) > _FAILOPEN_ORPHAN_SECS):
                        back.append(p)
            except OSError:
                pass
            st = _failopen_read(path)
            for p in back:
                st = _failopen_merge(st, _failopen_read(p))
            st = _failopen_merge(st, {"reasons": {failure_reason(reason): 1},
                                      "first": now, "last": now})
            _failopen_write(path, st)
            for p in back:
                try:
                    os.unlink(p)
                except OSError:
                    pass
    except Exception:
        pass


def claim_scan_failures() -> tuple:
    """Take the pending tally for the request about to be sent: (claim path, report), or
    ("", {}) when nothing is pending, which costs one rename that finds no file. The report
    is counts, reasons and two timestamps; nothing else is ever in it."""
    try:
        path = _failopen_path()
        claim = os.path.join(os.path.dirname(path), "." + _FAILOPEN_FILE + ".claim."
                             + str(os.getpid()) + "." + os.urandom(4).hex())
        os.rename(path, claim)
    except Exception:
        return "", {}
    try:
        os.utime(claim)          # a fresh claim, so the orphan sweep leaves it alone
    except OSError:
        pass
    report = _failopen_read(claim)
    if not report:
        scan_failures_delivered(claim)
        return "", {}
    return claim, report


def scan_failures_delivered(claim: str) -> None:
    """The backend accepted the request that carried this claim: drop it."""
    if claim:
        try:
            os.unlink(claim)
        except OSError:
            pass


def _post(endpoint: str, payload: dict, cfg: dict, ua: str = "") -> dict:
    """POST to a Palivane ingest endpoint; fail open (action=allow) on any error. Every
    fail-open is counted in the scan-failed ledger, and the pending tally rides on this
    request when there is one."""
    claim, report = claim_scan_failures()
    try:
        body = dict(payload)
        body["user"] = cfg.get("user", "")
        if report:
            body["scan_failed"] = report
        req = urllib.request.Request(
            cfg["url"].rstrip("/") + endpoint, method="POST",
            data=json.dumps(body).encode(),
            headers={"content-type": "application/json", "User-Agent": ua or agent_ua(),
                     "X-Palivane-Token": cfg["token"]},
        )
        with urllib.request.urlopen(req, timeout=cfg.get("timeout", 5.0)) as r:
            raw = r.read()
    except Exception as e:
        record_scan_failure(e, claim)
        return {"action": "allow", "reason": "scan-failed"}
    scan_failures_delivered(claim)          # the backend took the request, and the tally
    try:
        return json.loads(raw)
    except Exception as e:
        record_scan_failure(e)
        return {"action": "allow", "reason": "scan-failed"}


# --- The server's enforce stance, remembered between runs (#278) ------------------------
# Tool calls are scanned inline only under enforce. Otherwise a detached child reports them
# and nothing reads the verdict. PALIVANE_ENFORCE is the device's own stance, but the org can
# also enforce THIS actor from the console (Settings → Enforcement, or a per-user policy
# override), and the hook learns that only from the `enforce` field of an inline verdict.
# Prompts are scanned inline even in monitor mode, so each prompt verdict is a fresh reading:
# it is remembered here, and tool calls scan inline while it says enforce.
#
# The bit only chooses inline over detached. It never blocks anything by itself: the inline
# verdict decides, with its own live `enforce`. A stale or forged file costs latency at
# worst, and a missing one is plain monitor mode. The TTL lets a revoked override lapse even
# when no prompt comes along to clear it; a prompt verdict that says monitor clears it at
# once. It is keyed to the backend, key and user, so reconnecting as someone else never
# inherits it. Copied in palivane-hook, -cursor-hook, -codex-hook and -gemini-hook (each is
# a standalone file); keep the copies identical apart from _ENFORCE_FILE.
_ENFORCE_TTL = 3600
_ENFORCE_FILE = "enforce-cursor.json"


def _enforce_path() -> str:
    d = os.path.expanduser(os.getenv("PALIVANE_STATE_DIR", "~/.palivane"))
    return os.path.join(d, _ENFORCE_FILE)


def _enforce_key(cfg: dict) -> str:
    ident = "\n".join(str(cfg.get(k) or "") for k in ("url", "token", "user"))
    return hashlib.sha256(ident.encode()).hexdigest()[:16]


def remember_enforce(verdict: dict, cfg: dict, authoritative: bool) -> None:
    """Record the server's enforce stance from an inline verdict. A prompt verdict is
    `authoritative`: it sets or clears the bit. A tool-call verdict only refreshes a set bit,
    which keeps a long unattended run inline past the TTL. Its False does not clear, because
    a monitor override on one tool says nothing about the others. A fail-open verdict
    carries no `enforce` and changes nothing. Never raises."""
    v = verdict.get("enforce") if isinstance(verdict, dict) else None
    if not isinstance(v, bool) or not (v or authoritative):
        return
    try:
        path = _enforce_path()
        if not v:
            if os.path.exists(path):
                os.unlink(path)
            return
        d = os.path.dirname(path)
        os.makedirs(d, exist_ok=True)
        # A unique temp name per write, then an atomic rename: concurrent hook runs never
        # see a half-written file.
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".enforce.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as fh:
                json.dump({"key": _enforce_key(cfg), "until": time.time() + _ENFORCE_TTL}, fh)
            os.replace(tmp, path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
    except Exception:
        pass


def server_enforced(cfg: dict) -> bool:
    """True while the last server verdict for this backend, key and user said enforce and is
    younger than _ENFORCE_TTL. An `until` further out than the TTL is not one this code wrote
    (or the clock moved), so it does not count. Any error is False: plain monitor mode."""
    try:
        with open(_enforce_path()) as fh:
            st = json.load(fh)
        until, now = st.get("until"), time.time()
        if isinstance(until, bool) or not isinstance(until, (int, float)) or not math.isfinite(until):
            return False
        return st.get("key") == _enforce_key(cfg) and now < until <= now + _ENFORCE_TTL
    except Exception:
        return False


def should_block(verdict: dict, enforce: bool) -> bool:
    """Mirror of the proxy's rule: a confirmed secret/PII leak (force_block) is blocked
    even in monitor mode — block the certain, monitor the fuzzy. Everything else blocks
    under enforce — local, or the org's stance from the console (Settings → Enforcement),
    which the server returns on every verdict."""
    if verdict.get("force_block"):
        return True
    # A coached verdict is a block the org softened on the assumption that the client shows
    # the cleaned copy (only the extension can). Under enforce it still stops the prompt.
    return (enforce or bool(verdict.get("enforce"))) and (
        verdict.get("action") == "block" or verdict.get("coached") is True)


def _reason(verdict: dict) -> str:
    cats = ", ".join(dict.fromkeys(
        s.get("category", "") for s in verdict.get("signals", []) if s.get("category")))
    msg = (f"Blocked by Palivane: {cats or 'policy'} — "
           f"risk {verdict.get('risk_score', 0)}/{verdict.get('severity', 'high')}.")
    # Surface the fix inline in the IDE, not just the block (in-editor remediation).
    fixes = verdict.get("remediation") or []
    if fixes:
        msg += "\nHow to fix:\n" + "\n".join(f"  • {f}" for f in fixes[:4])
    return msg


def block_output(event_name: str, verdict: dict) -> dict:
    """Event-appropriate deny verdict for Cursor."""
    reason = _reason(verdict)
    if event_name == "beforeSubmitPrompt":
        return {"continue": False, "user_message": reason}
    return {"permission": "deny", "user_message": reason, "agent_message": reason}


def should_ask(event_name: str, verdict: dict) -> bool:
    """The org's ASK verdict: a tool call in the warn band that the org wants a person to
    approve rather than run silently. The server decides (it sets `ask` only for an enforced
    actor in a tenant that opted in), so this honors it on the events that can carry one.
    Callers check should_block first: a block is never softened into an ask. The same rule
    is copied in every hook; only _ASK_EVENTS differs."""
    return event_name in _ASK_EVENTS and bool(verdict.get("ask"))


def _ask_message(verdict: dict) -> str:
    """The question put to the developer. The reader is the user, so it carries the fix."""
    cats = ", ".join(dict.fromkeys(
        s.get("category", "") for s in verdict.get("signals", []) if s.get("category")))
    msg = (f"Palivane flagged this tool call ({cats or 'policy'}) — "
           f"risk {verdict.get('risk_score', 0)}/{verdict.get('severity', 'suspicious')}. "
           f"Approve it only if you meant to run it.")
    fixes = verdict.get("remediation") or []
    if fixes:
        msg += "\nHow to fix:\n" + "\n".join(f"  • {f}" for f in fixes[:4])
    return msg


def ask_output(verdict: dict) -> dict:
    """Cursor's own approval prompt for a shell or MCP call, with the reason."""
    return {"permission": "ask", "user_message": _ask_message(verdict)}


def allow_output(event_name: str) -> dict | None:
    """Explicit allow so monitor mode never leaves Cursor guessing. afterFileEdit takes
    no output."""
    if event_name == "afterFileEdit":
        return None
    if event_name == "beforeSubmitPrompt":
        return {"continue": True}
    return {"permission": "allow"}


def _send_detached(endpoint: str, payload: dict, cfg: dict) -> None:
    """Report in a detached child so the hook returns instantly (monitor mode)."""
    p = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--send"],
        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    p.stdin.write(json.dumps({"endpoint": endpoint, "payload": payload, "cfg": cfg}).encode())
    p.stdin.close()


def _event_cwd(event: dict) -> str:
    """The working directory this hook event happened in — the event's cwd, its tool_input's
    cwd, else the hook process's own cwd (the project root the CLI was launched in)."""
    cwd = event.get("cwd")
    if not cwd and isinstance(event.get("tool_input"), dict):
        cwd = event["tool_input"].get("cwd")
    return cwd or os.getcwd()


def _is_excluded(cwd: str, exclude: list) -> bool:
    """True if `cwd` is at/under an excluded dir (PALIVANE_HOOK_EXCLUDE_DIRS) — so developing
    Palivane itself doesn't flag its own secret fixtures on every tool call."""
    if not cwd or not exclude:
        return False
    try:
        rp = os.path.realpath(os.path.expanduser(cwd))
    except OSError:
        return False
    return any(rp == d or rp.startswith(d + os.sep) for d in exclude)


# --- keeping the plumbing current ---------------------------------------------------------
# palivane-posture refreshes the installed scripts (signed manifest, sha256 checked, atomic
# swap), but palivane-connect wires it only as a Claude Code SessionStart hook, so a machine
# that runs this tool and not Claude Code never updated. So the hook starts it, detached, at
# most every few hours, handing it this tool's URL and token (posture otherwise reads only
# Claude Code's settings). Posture keeps its own once-a-day throttle on the update itself.
# Only for an install in ~/.palivane/bin: that is the only copy posture is allowed to replace.
_POSTURE_KICK_S = 6 * 3600


def kick_posture(cfg: dict) -> None:
    try:
        if (os.getenv("PALIVANE_NO_SELF_UPDATE", "") or "").lower() in ("1", "true", "yes"):
            return
        here = os.path.dirname(os.path.abspath(__file__))
        if here != os.path.abspath(os.path.expanduser("~/.palivane/bin")):
            return
        posture = os.path.join(here, "palivane-posture")
        if not os.path.isfile(posture):
            return
        d = os.path.expanduser(os.getenv("PALIVANE_STATE_DIR", "~/.palivane"))
        stamp = os.path.join(d, "posture-kick")
        try:
            if time.time() - os.path.getmtime(stamp) < _POSTURE_KICK_S:
                return
        except OSError:
            pass
        os.makedirs(d, exist_ok=True)
        with open(stamp, "a"):
            pass
        os.utime(stamp, None)
        subprocess.Popen([sys.executable, posture, "--quiet"],
                         env={**os.environ, "PALIVANE_URL": cfg["url"], "PALIVANE_TOKEN": cfg["token"]},
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass   # never in the way of the hook's own job


def main() -> int:
    if "--send" in sys.argv[1:]:
        try:
            job = json.load(sys.stdin)
            _post(job["endpoint"], job["payload"], job["cfg"])
        except Exception:
            pass
        return 0

    try:
        event = json.load(sys.stdin)
    except Exception:
        return 0
    cfg = read_config()
    if _is_excluded(_event_cwd(event), cfg["exclude"]):
        return 0
    name = event.get("hook_event_name", "")

    if name == "beforeSubmitPrompt":
        endpoint, payload = "/api/ingest/ai-usage", build_ai_usage(event)
    else:
        payload = build_activity(event)
        endpoint = "/api/ingest/mcp"
    if payload is None:
        if endpoint.endswith("/ai-usage") and prompt_parse_miss(event):
            report_parse_miss(event, cfg)
        return 0

    if not cfg["url"] or not cfg["token"]:
        return 0  # not connected to Palivane — nothing to report to
    kick_posture(cfg)

    # Prompts are always scanned inline (even in monitor mode): a confirmed secret/PII
    # leak (force_block) must be stopped before it leaves the device. Other events scan
    # inline only under enforce: the device's own (PALIVANE_ENFORCE), or the server's as
    # last reported (the console's org stance or a per-user override, #278).
    # afterFileEdit can't be enforced (no output channel), so it never waits.
    prompt = name == "beforeSubmitPrompt"
    inline = prompt or (name != "afterFileEdit" and (cfg["enforce"] or server_enforced(cfg)))
    if inline:
        verdict = _post(endpoint, payload, cfg)
        remember_enforce(verdict, cfg, authoritative=prompt)
        if should_block(verdict, cfg["enforce"]):
            print(json.dumps(block_output(name, verdict)))
            return 0
        if should_ask(name, verdict):
            print(json.dumps(ask_output(verdict)))
            return 0
        out = allow_output(name)
        if out is not None:
            print(json.dumps(out))
        return 0

    _send_detached(endpoint, payload, cfg)
    out = allow_output(name)
    if out is not None:
        print(json.dumps(out))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # fail open — never break the developer's session
