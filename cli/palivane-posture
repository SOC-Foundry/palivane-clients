# >>> palivane release-verify (keep identical in every client script that carries it;
# test_release_verify.py checks they match and that the key is release_signing's)
# Everything these scripts download after install is checked the way install.sh checks the
# install itself: /cli/manifest.sig (ECDSA P-256 / SHA-256 over the canonical {name: sha256}
# map) must verify under the PINNED release key, then each file's sha256 must match the
# manifest. Anything else is refused and the installed copy is kept. TLS alone proves who
# served the bytes, not that they are a release the vendor signed.
_VENDOR_RELEASE_PUBKEY = """-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEtwIOdXmgRU12/7oDPzpkLqrud1DN
s2ngn344uoGU+MF5HUF7gFG2emj+UG3aPvm5Jbh+ggQdxs9R7ZZ1PwoP9Q==
-----END PUBLIC KEY-----
"""
_RELEASE_PUBKEY_PATH = "~/.palivane/release-pubkey.pem"      # written by install.sh
_RELEASE_REQUIRE_SIG_PATH = "~/.palivane/release-require-sig"  # "0" = deployment unsigned


def _release_pubkey() -> str:
    """The pinned key: PALIVANE_RELEASE_PUBKEY, else the key install.sh persisted from the
    deployment it installed from (a self-host's own key), else the vendor key above."""
    import os
    pem = (os.environ.get("PALIVANE_RELEASE_PUBKEY") or "").strip()
    if pem:
        return pem
    try:
        with open(os.path.expanduser(_RELEASE_PUBKEY_PATH)) as f:
            pem = f.read().strip()
        if "BEGIN PUBLIC KEY" in pem:
            return pem
    except OSError:
        pass
    return _VENDOR_RELEASE_PUBKEY.strip()


def _unsigned_release_allowed() -> bool:
    """An unsigned manifest is accepted only when the install recorded that its deployment
    does not sign (install.sh REQUIRE_SIG=0/skip), or PALIVANE_RELEASE_REQUIRE_SIG=0 says so.
    No record means a signature is required: fail closed."""
    import os
    v = (os.environ.get("PALIVANE_RELEASE_REQUIRE_SIG") or "").strip()
    if not v:
        try:
            with open(os.path.expanduser(_RELEASE_REQUIRE_SIG_PATH)) as f:
                v = f.read().strip()
        except OSError:
            v = ""
    return v in ("0", "skip")


def _verify_release_sig(message: bytes, sig_b64: bytes, pubkey_pem: str):
    """True = verified, False = rejected, None = nothing on this machine can verify (no
    `cryptography`, no openssl). Same check as install.sh's `openssl dgst -sha256 -verify`."""
    import base64
    import os
    import shutil
    import subprocess
    import tempfile
    try:
        sig = base64.b64decode(sig_b64.strip(), validate=True)
    except (ValueError, TypeError):
        return False
    try:
        from cryptography.exceptions import InvalidSignature
        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.hazmat.primitives.serialization import load_pem_public_key
    except ImportError:
        pass
    else:
        try:
            load_pem_public_key(pubkey_pem.encode()).verify(
                sig, message, ec.ECDSA(hashes.SHA256()))
            return True
        except (InvalidSignature, ValueError, TypeError):
            return False
    openssl = shutil.which("openssl")
    if not openssl:
        return None
    d = tempfile.mkdtemp(prefix="palivane-verify-")      # 0700: private to this user
    try:
        paths = []
        for name, blob in (("pub.pem", pubkey_pem.encode()), ("sig.der", sig), ("msg", message)):
            p = os.path.join(d, name)
            with open(p, "wb") as f:
                f.write(blob)
            paths.append(p)
        r = subprocess.run([openssl, "dgst", "-sha256", "-verify", paths[0],
                            "-signature", paths[1], paths[2]],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        shutil.rmtree(d, ignore_errors=True)


def _verified_manifest(fetch):
    """The release manifest, or None unless it is authentic. `fetch(name)` returns the bytes
    of <base>/cli/<name>, or None on any failure (a 404 for manifest.sig included)."""
    import json
    raw = fetch("manifest.json")
    if raw is None:
        return None
    try:
        manifest = json.loads(raw)
        hashes = {str(k): str(v["sha256"]) for k, v in manifest["files"].items()}
    except Exception:                                           # noqa: BLE001
        return None
    # Must match release_signing.canonical_files_digest byte for byte.
    message = json.dumps(hashes, separators=(",", ":"), sort_keys=True).encode()
    sig = fetch("manifest.sig")
    ok = _verify_release_sig(message, sig, _release_pubkey()) if sig else None
    if ok is False:
        return None
    if ok is None and not _unsigned_release_allowed():
        return None
    return manifest


def _matches_manifest(manifest: dict, name: str, blob: bytes) -> bool:
    import hashlib
    want = ((manifest.get("files") or {}).get(name) or {}).get("sha256", "")
    return bool(want) and hashlib.sha256(blob).hexdigest() == want
# <<< palivane release-verify


# >>> palivane detect-loader (keep identical across the scripts that carry it)
def _fetch_detect_verified(base: str):
    """palivane_detect.py from `base`, verified against the signed release manifest and
    loaded from memory. It used to be written to a fixed path in the shared temp dir and
    executed from there, so any local user who created that file first chose the code."""
    import sys
    import types
    import urllib.request

    def fetch(name):
        try:
            with urllib.request.urlopen(f"{base}/cli/{name}", timeout=20) as r:
                return r.read() if 200 <= r.status < 300 else None
        except Exception:                                       # noqa: BLE001
            return None

    manifest = _verified_manifest(fetch)
    body = fetch("palivane_detect.py") if manifest is not None else None
    if body is None or not _matches_manifest(manifest, "palivane_detect.py", body):
        sys.exit(f"could not fetch a verified palivane_detect.py from {base} (unreachable, "
                 "or its release signature/hash did not check out). Place "
                 "palivane_detect.py next to this script, or reinstall with install.sh.")
    mod = types.ModuleType("palivane_detect")
    mod.__file__ = f"{base}/cli/palivane_detect.py"
    sys.modules["palivane_detect"] = mod
    exec(compile(body, "palivane_detect.py", "exec"), mod.__dict__)
    return mod
# <<< palivane detect-loader


# Detection is shared with palivane-secrets and the at-rest scanners and is installed
# beside this script. Fall back to fetching it from the deployment this reports to rather
# than failing with an ImportError the user cannot act on.
def _load_detect():
    import importlib.util
    here = os.path.dirname(os.path.abspath(__file__))
    path = os.path.join(here, "palivane_detect.py")
    if not os.path.exists(path):
        base = (os.environ.get("PALIVANE_URL") or "").rstrip("/")
        if not base:
            sys.exit("palivane_detect.py not found next to this script and PALIVANE_URL "
                     "is unset, so it cannot be fetched. Download it from "
                     "<your-palivane-url>/cli/palivane_detect.py into the same directory.")
        return _fetch_detect_verified(base)
    spec = importlib.util.spec_from_file_location("palivane_detect", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


detect = _load_detect()


def _findings(text: str, server: str = "") -> list[dict]:
    """What palivane_detect found in `text`, in the metadata form the scan APIs take."""
    out = [{"category": c, "label": lbl, "line": ln, "masked": mk}
           for c, lbl, ln, mk in detect.scan_all(text)]
    if server:
        for fd in out:
            fd["server"] = server
    return out


# `palivane connect` writes Palivane's own capture key into an agent's settings.json, as
# PALIVANE_TOKEN and, when it routes through our gateway, as ANTHROPIC_AUTH_TOKEN, because the
# hook cannot work without it. Reading that file back and reporting the key as a "possible
# secret" put a finding on every enrolled machine, and beside any real finding in the same file
# it tipped a warning into critical. Only the VALUE of those two settings is exempt, and only
# when it is one of our `ak_` keys: a second key pasted elsewhere in the file, or someone
# else's token in the same variable, still reports.
_OWN_KEY_RE = re.compile(r'("(?:PALIVANE_TOKEN|ANTHROPIC_AUTH_TOKEN)"\s*:\s*")(ak_[^"\\]*)(")')


def _without_own_credential(content: str) -> str:
    """`content` with our own key's value blanked in place. Same length, same lines, so a
    finding elsewhere in the file keeps the line number someone will need to find it by."""
    return _OWN_KEY_RE.sub(lambda m: m.group(1) + "x" * len(m.group(2)) + m.group(3), content)


def mcp_findings(content: str) -> list[dict]:
    """Secrets in an MCP config, attributed to the server they were declared under.

    Mirrors what the backend used to scan per server — the command, its args, and every
    env VALUE joined together — so moving the detection here changes where it runs and
    nothing else. A config that will not parse still gets scanned as a whole; those
    findings carry no server and the backend reports them against the file."""
    try:
        j = json.loads(content)
        servers = j.get("mcpServers") or j.get("servers") or (j.get("mcp") or {}).get("servers")
    except (ValueError, TypeError, AttributeError):
        servers = None
    if not isinstance(servers, dict):
        return _findings(content)
    out: list[dict] = []
    for name, spec in servers.items():
        if not isinstance(spec, dict):
            continue
        env = spec.get("env")
        args_text = " ".join(
            [str(spec.get("command", ""))]
            + [str(a) for a in (spec.get("args") or [])]
            + [str(v) for v in (env.values() if isinstance(env, dict) else [])])
        out.extend(_findings(args_text, server=str(name)))
    return out


def _user() -> str:
    """Best-effort identity for per-user attribution of endpoint findings."""
    import getpass
    return os.getenv("PALIVANE_USER") or (getpass.getuser() if hasattr(getpass, "getuser") else "") or ""


def collect_agent_rules(cwd: str = ".") -> list[tuple[str, str, str, str]]:
    """Read agent instruction/rules files present on the device. Returns
    (label, content, path, tool). Repo-relative files come from `cwd`; user-level ones
    from home. Bounded read + a cap on directory files so a huge skills tree can't stall
    a session-start hook."""
    out: list[tuple[str, str, str, str]] = []
    seen: set[str] = set()

    def _add(label: str, fspath: str, tool: str) -> None:
        rp = os.path.realpath(fspath)
        if rp in seen:
            return
        try:
            with open(fspath, encoding="utf-8", errors="replace") as f:
                content = f.read(200_000)
        except Exception:
            return
        if content.strip():
            seen.add(rp)
            out.append((label, content, label, tool))

    for label, relto, path, tool in _RULES_FILES:
        base = os.path.join(cwd, path) if relto == "cwd" else os.path.expanduser(path)
        _add(label, base, tool)
    for label, relto, path, patterns, tool in _RULES_GLOBS:
        root = os.path.join(cwd, path) if relto == "cwd" else os.path.expanduser(path)
        try:
            import fnmatch
            hits = 0
            for dirpath, _dirs, files in os.walk(root):
                for fn in sorted(files):
                    if any(fnmatch.fnmatch(fn, pat) for pat in patterns):
                        rel = os.path.relpath(os.path.join(dirpath, fn), root)
                        _add(f"{label}/{rel}", os.path.join(dirpath, fn), tool)
                        hits += 1
                        if hits >= 100:      # cap: don't walk an enormous skills tree
                            break
                if hits >= 100:
                    break
        except Exception:
            continue
    return out


def collect_agent_configs() -> list[tuple[str, str, str]]:
    """Read AI coding-assistant settings files that exist. Returns (label, content, tool)."""
    out, seen = [], set()
    for label, path, tool in _AGENT_CONFIGS:
        p = os.path.expanduser(path)
        if p in seen:
            continue
        try:
            with open(p) as f:
                content = f.read(200_000)
        except Exception:
            continue
        if content.strip():
            seen.add(p)
            out.append((label, content, tool))
    return out


def _settings_env(path: str = "~/.claude/settings.json") -> dict:
    try:
        with open(os.path.expanduser(path)) as f:
            env = json.load(f).get("env")
        return env if isinstance(env, dict) else {}
    except Exception:
        return {}


def read_config() -> dict:
    """Backend URL/token: environment first, then ~/.claude/settings.json (the gateway
    ak_ token doubles as the ingest credential, its base URL locates the backend)."""
    senv = _settings_env()
    url = os.getenv("PALIVANE_URL") or senv.get("PALIVANE_URL", "")
    token = os.getenv("PALIVANE_TOKEN") or senv.get("PALIVANE_TOKEN", "")
    if not token:
        gw = senv.get("ANTHROPIC_AUTH_TOKEN", "")
        if isinstance(gw, str) and gw.startswith("ak_"):
            token = gw
    if not url:
        base = senv.get("ANTHROPIC_BASE_URL", "")
        if isinstance(base, str) and base:
            url = base.rstrip("/")
            if url.endswith("/v1"):
                url = url[: -len("/v1")]
    return {"url": url.rstrip("/"), "token": token}


# --- collection -------------------------------------------------------------------------

def collect_ide_extensions() -> list[str] | None:
    """Installed VS Code extension ids, or None when `code` isn't available."""
    code = shutil.which("code")
    if not code:
        return None
    try:
        out = subprocess.run([code, "--list-extensions"], capture_output=True,
                             text=True, timeout=5)
        if out.returncode != 0:
            return None
        return sorted({ln.strip() for ln in out.stdout.splitlines() if ln.strip()})
    except Exception:
        return None


def synthesize_claude_config(raw: str) -> str | None:
    """A minimal {"mcpServers": …} document from ~/.claude.json — merges the top-level
    servers with every project's, and carries nothing else from the file."""
    try:
        data = json.loads(raw)
    except (ValueError, TypeError):
        return None
    if not isinstance(data, dict):
        return None
    servers: dict = {}
    top = data.get("mcpServers")
    if isinstance(top, dict):
        servers.update(top)
    projects = data.get("projects")
    if isinstance(projects, dict):
        for proj in projects.values():
            if isinstance(proj, dict) and isinstance(proj.get("mcpServers"), dict):
                for name, cfg in proj["mcpServers"].items():
                    servers.setdefault(name, cfg)
    if not servers:
        return None
    return json.dumps({"mcpServers": servers}, sort_keys=True)


def find_mcp_configs(cwd: str = ".") -> list[tuple[str, str]]:
    """(path-label, canonical content) pairs for every MCP config present on the device."""
    found: list[tuple[str, str]] = []
    claude_path = os.path.expanduser("~/.claude.json")
    if os.path.exists(claude_path):
        try:
            synth = synthesize_claude_config(open(claude_path).read())
            if synth:
                found.append(("~/.claude.json", synth))
        except OSError:
            pass
    for label, path in _RAW_MCP_CONFIGS:
        p = os.path.join(cwd, ".mcp.json") if label == "./.mcp.json" else os.path.expanduser(path)
        if os.path.exists(p):
            try:
                found.append((label, open(p).read()))
            except OSError:
                pass
    return found


# --- device health (capture-plane collisions & coverage gaps) ---------------------------
# Raw state only — the device_posture detector server-side decides what's a finding, so
# the rules update fleet-wide on a backend deploy. Everything here is best-effort and
# bounded; a check that can't run reports nothing rather than failing the posture run.

def _proxy_port() -> int:
    try:
        return int(os.getenv("PALIVANE_PROXY_PORT", "") or 8081)
    except ValueError:
        return 8081


def _port_listening(port: int) -> bool:
    import socket
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=1):
            return True
    except OSError:
        return False


def _listener_name(port: int) -> str:
    """Best-effort name of the process listening on `port` (ss on Linux, lsof on macOS)."""
    for cmd in ([shutil.which("ss") or "", "-tlnp"],
                [shutil.which("lsof") or "", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN"]):
        if not cmd[0]:
            continue
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
        except Exception:
            continue
        for line in out.splitlines():
            if f":{port}" not in line:
                continue
            if 'users:(("' in line:                      # ss: users:(("name",pid=…,fd=…))
                return line.split('users:(("', 1)[1].split('"', 1)[0]
            if not line.startswith("COMMAND"):           # lsof: first column is the command
                return line.split()[0]
    return ""


def _strip_cred(url: str) -> str:
    """Proxy URLs can carry basic-auth credentials — never report those."""
    scheme, sep, rest = url.partition("://")
    if sep and "@" in rest:
        rest = rest.rsplit("@", 1)[1]
    return f"{scheme}{sep}{rest}"


def _breaker_state() -> dict:
    try:
        with open(os.path.expanduser("~/.palivane/proxy-breaker.json")) as f:
            data = json.load(f)
    except Exception:
        return {"cooldown_active": False, "deauth_active": False}
    now = datetime.now(timezone.utc).timestamp()
    # Booleans only (not the raw timestamps): the report stays byte-stable while a state
    # holds, so the dedup cache posts on transitions instead of every re-run.
    return {"cooldown_active": now < (data.get("cooldown_until") or 0),
            "deauth_active": now < (data.get("deauth_until") or 0)}


def _local_llms() -> list[dict]:
    """Local model runtimes — shadow AI with zero network tell (nothing for the proxy,
    extension, or gateway to see). Raw presence only; the server decides the finding."""
    out = []
    if shutil.which("ollama") or os.path.isdir(os.path.expanduser("~/.ollama")):
        out.append({"name": "ollama", "listening": _port_listening(11434)})
    for d in ("~/.lmstudio", "~/.cache/lm-studio",
              "~/Library/Application Support/LM Studio"):
        if os.path.isdir(os.path.expanduser(d)):
            out.append({"name": "lm studio", "listening": _port_listening(1234)})
            break
    if shutil.which("llamafile"):
        out.append({"name": "llamafile", "listening": _port_listening(8080)})
    for d in ("~/.gpt4all", "~/Library/Application Support/nomic.ai"):
        if os.path.isdir(os.path.expanduser(d)):
            out.append({"name": "gpt4all", "listening": _port_listening(4891)})
            break
    return out


def collect_device_health() -> dict:
    port = _proxy_port()
    listening = _port_listening(port)
    proxy_env = _strip_cred(
        os.getenv("HTTPS_PROXY") or os.getenv("https_proxy")
        or os.getenv("HTTP_PROXY") or os.getenv("http_proxy") or "")
    points_local = any(f"{h}:{port}" in proxy_env for h in ("127.0.0.1", "localhost"))
    try:
        with open("/proc/version") as f:
            wsl = "microsoft" in f.read().lower()
    except OSError:
        wsl = False
    return {
        "proxy": {"port": port, "listening": listening,
                  "listener": _listener_name(port) if listening else "",
                  "env_proxy": proxy_env, "env_points_local": points_local},
        "breaker": _breaker_state(),
        "gaps": {"wsl": wsl, "docker_present": shutil.which("docker") is not None,
                 "in_container": os.path.exists("/.dockerenv")},
        "local_llms": _local_llms(),
    }


# --- change-dedup cache -----------------------------------------------------------------

def digest(content: str) -> str:
    return hashlib.sha256(content.encode()).hexdigest()


def load_cache(path: str) -> dict:
    try:
        with open(os.path.expanduser(path)) as f:
            cache = json.load(f)
        if isinstance(cache, dict) and isinstance(cache.get("entries"), dict):
            return cache
    except Exception:
        pass
    return {"version": 1, "backend": "", "entries": {}}


def save_cache(path: str, cache: dict) -> None:
    """Atomic (temp + os.replace): the --async child can be killed at any moment, and a
    truncated cache reads as empty next run — which would re-post every finding."""
    p = os.path.expanduser(path)
    os.makedirs(os.path.dirname(p), mode=0o700, exist_ok=True)
    tmp = f"{p}.tmp"
    with open(tmp, "w") as f:
        json.dump(cache, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)


def should_post(cache: dict, backend: str, key: str, dig: str) -> bool:
    """Post when the content changed since the last successful report — or when the
    backend changed (a new backend has none of our earlier reports)."""
    if cache.get("backend") != backend:
        return True
    entry = cache["entries"].get(key)
    return not (isinstance(entry, dict) and entry.get("sha256") == dig)


def _mark_posted(cache: dict, backend: str, key: str, dig: str) -> None:
    if cache.get("backend") != backend:
        cache["backend"] = backend
        cache["entries"] = {}
    cache["entries"][key] = {"sha256": dig,
                             "at": datetime.now(timezone.utc).isoformat(timespec="seconds")}


# --- reporting --------------------------------------------------------------------------

def _post(cfg: dict, api_path: str, body: dict, timeout: float = 10.0) -> bool:
    """POST one report; True only on 2xx (so failures retry next run)."""
    try:
        req = urllib.request.Request(
            cfg["url"] + api_path, method="POST", data=json.dumps(body).encode(),
            headers={"content-type": "application/json", "User-Agent": f"palivane-posture/{VERSION}", "X-Palivane-Token": cfg["token"]},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return 200 <= r.status < 300
    except Exception:
        return False


# --- self-update ------------------------------------------------------------------------
# Palivane's *decisions* are server-side, so detector/policy/judge changes reach every device
# the moment the backend deploys — nothing here is needed for those. What DOES go stale on
# disk is the plumbing: these hook scripts, the proxy addon, and palivane-secrets' local
# patterns. This refreshes those from the backend that already governs the device.
#
# Rules, in order of importance:
#   * Only ever replace files that already exist locally (never install new tools silently).
#   * Trust the manifest only once its release signature verifies under the pinned key,
#     then verify each file's sha256 against it BEFORE swapping; a mismatch aborts that file.
#   * Swap atomically (temp file in the same dir + os.replace), so a killed process can't
#     leave a half-written hook — the old one keeps working.
#   * Skip anything not writable by us (MDM-managed copies under /usr/local/bin stay the
#     MDM's job) and honor PALIVANE_NO_SELF_UPDATE=1 plus the server's own kill switch.
#   * Never block a session: throttled to once a day, and every failure is silent.
_UPDATE_INTERVAL_S = 86400
# Where installed copies live: the CLI tools in ~/.palivane/bin, the proxy addon in ~/.palivane.
_UPDATE_DIRS = ("~/.palivane/bin", "~/.palivane")


def _self_update_disabled() -> bool:
    return (os.getenv("PALIVANE_NO_SELF_UPDATE", "") or "").lower() in ("1", "true", "yes")


def _fetch(url: str, token: str, timeout: float = 20.0) -> bytes | None:
    try:
        req = urllib.request.Request(url, headers={
            "User-Agent": f"palivane-posture/{VERSION}", "X-Palivane-Token": token})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            if not (200 <= r.status < 300):
                return None
            return r.read()
    except Exception:
        return None


def _installed_paths(name: str) -> list[str]:
    """Local copies of `name` we're allowed to touch (existing + writable files only)."""
    out = []
    for d in _UPDATE_DIRS:
        p = os.path.join(os.path.expanduser(d), name)
        if os.path.isfile(p) and os.access(p, os.W_OK):
            out.append(p)
    return out


def _replace_atomic(path: str, blob: bytes) -> bool:
    """Write `blob` over `path` atomically, preserving its executable bit."""
    tmp = f"{path}.palivane-new"
    try:
        mode = os.stat(path).st_mode
        with open(tmp, "wb") as f:
            f.write(blob)
        os.chmod(tmp, mode)
        os.replace(tmp, path)       # atomic within the same filesystem
        return True
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def self_update(cfg: dict, cache: dict, force: bool = False,
                dry_run: bool = False, say=print) -> int:
    """Refresh installed Palivane scripts whose hash differs from the backend's manifest.
    Returns the number updated (0 on any skip/failure — this never raises)."""
    if _self_update_disabled():
        return 0
    last = cache.get("update_checked_at_epoch") or 0
    now = int(datetime.now(timezone.utc).timestamp())
    if not force and (now - last) < _UPDATE_INTERVAL_S:
        return 0
    cache["update_checked_at_epoch"] = now

    base = cfg["url"].rstrip("/")
    # The manifest is trusted only once its release signature verifies under the pinned
    # key (see release-verify above); an unsigned or forged one updates nothing.
    manifest = _verified_manifest(lambda name: _fetch(f"{base}/cli/{name}", cfg["token"]))
    if manifest is None:
        say("skipped self-update: release manifest signature did not verify")
        return 0
    files = manifest["files"]
    if manifest.get("self_update") is False:      # server-side kill switch
        return 0

    updated = 0
    for name, meta in sorted(files.items()):
        want = (meta or {}).get("sha256", "")
        if not want:
            continue
        for path in _installed_paths(name):
            try:
                with open(path, "rb") as f:
                    have = hashlib.sha256(f.read()).hexdigest()
            except OSError:
                continue
            if have == want:
                continue
            if dry_run:
                say(f"would update {name} ({path})")
                updated += 1
                continue
            blob = _fetch(f"{base}/cli/{name}", cfg["token"])
            if blob is None:
                continue
            if not _matches_manifest(manifest, name, blob):
                say(f"skipped {name}: hash mismatch (served content != manifest)")
                continue
            if _replace_atomic(path, blob):
                updated += 1
                say(f"updated {name} -> {manifest.get('version', '?')} ({path})")
    return updated


def run(cfg: dict, cache_path: str = CACHE_PATH, cwd: str = ".",
        force: bool = False, dry_run: bool = False, quiet: bool = False) -> int:
    say = (lambda *a: None) if quiet else print
    cache = load_cache(cache_path)
    reported = skipped = 0

    items: list[tuple[str, str, dict, str]] = []  # (key, api_path, body, canonical)
    exts = collect_ide_extensions()
    if exts is not None:
        canonical = "\n".join(exts)
        items.append(("ide-extensions", "/api/scan/ide-extensions",
                      {"extensions": exts, "record": True}, canonical))
    # The three file-backed payloads. Each is scanned here and posted REDACTED — the
    # canonical text kept for the change cache stays the real file, so rotating a token
    # still reads as drift and re-reports.
    for label, content in find_mcp_configs(cwd):
        items.append((f"mcp:{label}", "/api/scan/mcp-config",
                      {"content": detect.redact(content), "path": label,
                       "findings": mcp_findings(content), "record": True}, content))
    user = _user()
    for label, content, tool in collect_agent_configs():
        items.append((f"agent:{label}", "/api/scan/agent-config",
                      {"content": detect.redact(content), "tool": tool, "user": user,
                       "findings": _findings(_without_own_credential(content)),
                       "record": True}, content))
    for label, content, path, tool in collect_agent_rules(cwd):
        items.append((f"rules:{label}", "/api/scan/agent-rules",
                      {"content": detect.redact(content), "path": path, "tool": tool,
                       "user": user, "findings": _findings(content), "record": True}, content))
    health = json.dumps(collect_device_health(), sort_keys=True)
    items.append(("device-posture", "/api/scan/device-posture",
                  {"content": health, "user": user, "record": True}, health))

    for key, api_path, body, canonical in items:
        dig = digest(canonical)
        if not force and not should_post(cache, cfg["url"], key, dig):
            skipped += 1
            continue
        if dry_run:
            say(f"would post {key}")
            reported += 1
            continue
        if _post(cfg, api_path, body):
            _mark_posted(cache, cfg["url"], key, dig)
            reported += 1
            say(f"posted {key}")
            # Persist the mark NOW, not at the end of the run: the --async child can be
            # killed any time (session end), and self_update below spends seconds on the
            # network — dying there forgot every mark and re-posted the whole run's
            # findings next session. Best-effort: the final save (or next run) retries.
            try:
                save_cache(cache_path, cache)
            except OSError:
                pass
        else:
            say(f"failed {key} (will retry next run)")

    # Pick up new hook/addon/scanner code (throttled, silent on failure). Runs after the
    # reports so a bad update can never cost this session its posture data — and at session
    # START, so nothing is swapped underneath a hook that's mid-invocation.
    updated = self_update(cfg, cache, force=force, dry_run=dry_run, say=say)

    if not dry_run and (reported or updated or cache.get("update_checked_at_epoch")):
        save_cache(cache_path, cache)
    tail = f", {updated} updated" if updated else ""
    say(f"palivane-posture: {reported} reported, {skipped} unchanged{tail}")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if "--async" in args:
        # Detach and return immediately — the SessionStart-hook entrypoint.
        rest = [a for a in args if a != "--async"]
        subprocess.Popen([sys.executable, os.path.abspath(__file__), *rest, "--quiet"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return 0
    cfg = read_config()
    if not cfg["url"] or not cfg["token"]:
        if "--quiet" not in args:
            print("palivane-posture: not connected (set PALIVANE_URL/PALIVANE_TOKEN or run palivane-connect)")
        return 0
    return run(cfg, force="--force" in args, dry_run="--dry-run" in args,
               quiet="--quiet" in args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # fail open
