#!/usr/bin/env python3
"""Palivane GitHub scan plane — sweep whole GitHub repos (or entire orgs/users) for secrets & PII.

Reads repositories over the GitHub API and detects HERE, on the machine running the scan,
then reports only what it found to `POST /api/scan/code`: category, label, line number, and
a masked preview. Your source never reaches Palivane. This used to POST every text blob of
every repo — an `--org` sweep uploaded an entire private codebase for the privilege of being
told it held a key, which is the opposite of what this product is for. Detection is shared
with palivane-secrets and palivane-s3-scan (palivane_detect.py) so the three cannot drift.

Nothing is written back to GitHub — this is a read-only audit. Stdlib only.

Config (env):
  PALIVANE_URL     Palivane backend base URL                    (or --url)
  PALIVANE_TOKEN   a per-tenant API key (ak_…)                 (env only, never a CLI flag)
  GITHUB_TOKEN   a GitHub PAT for the API                    (env only)

Usage:
  palivane-github-scan --org acme                     # every repo in an org
  palivane-github-scan --user octocat                 # every repo for a user
  palivane-github-scan --repo acme/api --repo acme/web # explicit repos (repeatable)
  palivane-github-scan --org acme --include-archived  # also scan archived/fork repos
  palivane-github-scan --org acme --github-api https://ghe.corp/api/v3  # GitHub Enterprise

Exit codes: 0 = clean/allowed, 1 = a blocking finding. A GitHub or backend error fails OPEN
(exit 0) unless --fail-closed is given. A GitHub rate-limit stops the scan (fail-closed => 1).
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import sys
import tempfile
import urllib.error
import urllib.request

MAX_CONTENT = 200_000        # cap on how much of one blob we scan locally
BATCH = 200                  # files per /api/scan/code request — findings-only, so a batch
                             # is now metadata and can be far larger than the old 50 blobs
GITHUB_API = "https://api.github.com"

# scan_blob's third answer. "Clean" and "could not read this as text" are both "nothing to
# report", but only the first means a file was actually scanned, and the summary line has to
# tell the truth about which happened.
UNREADABLE = object()


# >>> palivane release-verify (keep identical in every client script that carries it;
# test_release_verify.py checks they match and that the key is release_signing's)
# Everything these scripts download after install is checked the way install.sh checks the
# install itself: /cli/manifest.sig (ECDSA P-256 / SHA-256 over the canonical {name: sha256}
# map) must verify under the PINNED release key, then each file's sha256 must match the
# manifest. Anything else is refused and the installed copy is kept. TLS alone proves who
# served the bytes, not that they are a release the vendor signed.
_VENDOR_RELEASE_PUBKEY = """-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEtwIOdXmgRU12/7oDPzpkLqrud1DN
s2ngn344uoGU+MF5HUF7gFG2emj+UG3aPvm5Jbh+ggQdxs9R7ZZ1PwoP9Q==
-----END PUBLIC KEY-----
"""
_RELEASE_PUBKEY_PATH = "~/.palivane/release-pubkey.pem"      # written by install.sh
_RELEASE_REQUIRE_SIG_PATH = "~/.palivane/release-require-sig"  # "0" = deployment unsigned


def _release_pubkey() -> str:
    """The pinned key: PALIVANE_RELEASE_PUBKEY, else the key install.sh persisted from the
    deployment it installed from (a self-host's own key), else the vendor key above."""
    import os
    pem = (os.environ.get("PALIVANE_RELEASE_PUBKEY") or "").strip()
    if pem:
        return pem
    try:
        with open(os.path.expanduser(_RELEASE_PUBKEY_PATH)) as f:
            pem = f.read().strip()
        if "BEGIN PUBLIC KEY" in pem:
            return pem
    except OSError:
        pass
    return _VENDOR_RELEASE_PUBKEY.strip()


def _unsigned_release_allowed() -> bool:
    """An unsigned manifest is accepted only when the install recorded that its deployment
    does not sign (install.sh REQUIRE_SIG=0/skip), or PALIVANE_RELEASE_REQUIRE_SIG=0 says so.
    No record means a signature is required: fail closed."""
    import os
    v = (os.environ.get("PALIVANE_RELEASE_REQUIRE_SIG") or "").strip()
    if not v:
        try:
            with open(os.path.expanduser(_RELEASE_REQUIRE_SIG_PATH)) as f:
                v = f.read().strip()
        except OSError:
            v = ""
    return v in ("0", "skip")


def _verify_release_sig(message: bytes, sig_b64: bytes, pubkey_pem: str):
    """True = verified, False = rejected, None = nothing on this machine can verify (no
    `cryptography`, no openssl). Same check as install.sh's `openssl dgst -sha256 -verify`."""
    import base64
    import os
    import shutil
    import subprocess
    import tempfile
    try:
        sig = base64.b64decode(sig_b64.strip(), validate=True)
    except (ValueError, TypeError):
        return False
    try:
        from cryptography.exceptions import InvalidSignature
        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.hazmat.primitives.serialization import load_pem_public_key
    except ImportError:
        pass
    else:
        try:
            load_pem_public_key(pubkey_pem.encode()).verify(
                sig, message, ec.ECDSA(hashes.SHA256()))
            return True
        except (InvalidSignature, ValueError, TypeError):
            return False
    openssl = shutil.which("openssl")
    if not openssl:
        return None
    d = tempfile.mkdtemp(prefix="palivane-verify-")      # 0700: private to this user
    try:
        paths = []
        for name, blob in (("pub.pem", pubkey_pem.encode()), ("sig.der", sig), ("msg", message)):
            p = os.path.join(d, name)
            with open(p, "wb") as f:
                f.write(blob)
            paths.append(p)
        r = subprocess.run([openssl, "dgst", "-sha256", "-verify", paths[0],
                            "-signature", paths[1], paths[2]],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        shutil.rmtree(d, ignore_errors=True)


def _verified_manifest(fetch):
    """The release manifest, or None unless it is authentic. `fetch(name)` returns the bytes
    of <base>/cli/<name>, or None on any failure (a 404 for manifest.sig included)."""
    import json
    raw = fetch("manifest.json")
    if raw is None:
        return None
    try:
        manifest = json.loads(raw)
        hashes = {str(k): str(v["sha256"]) for k, v in manifest["files"].items()}
    except Exception:                                           # noqa: BLE001
        return None
    # Must match release_signing.canonical_files_digest byte for byte.
    message = json.dumps(hashes, separators=(",", ":"), sort_keys=True).encode()
    sig = fetch("manifest.sig")
    ok = _verify_release_sig(message, sig, _release_pubkey()) if sig else None
    if ok is False:
        return None
    if ok is None and not _unsigned_release_allowed():
        return None
    return manifest


def _matches_manifest(manifest: dict, name: str, blob: bytes) -> bool:
    import hashlib
    want = ((manifest.get("files") or {}).get(name) or {}).get("sha256", "")
    return bool(want) and hashlib.sha256(blob).hexdigest() == want
# <<< palivane release-verify


# >>> palivane detect-loader (keep identical across the scripts that carry it)
def _fetch_detect_verified(base: str):
    """palivane_detect.py from `base`, verified against the signed release manifest and
    loaded from memory. It used to be written to a fixed path in the shared temp dir and
    executed from there, so any local user who created that file first chose the code."""
    import sys
    import types
    import urllib.request

    def fetch(name):
        try:
            with urllib.request.urlopen(f"{base}/cli/{name}", timeout=20) as r:
                return r.read() if 200 <= r.status < 300 else None
        except Exception:                                       # noqa: BLE001
            return None

    manifest = _verified_manifest(fetch)
    body = fetch("palivane_detect.py") if manifest is not None else None
    if body is None or not _matches_manifest(manifest, "palivane_detect.py", body):
        sys.exit(f"could not fetch a verified palivane_detect.py from {base} (unreachable, "
                 "or its release signature/hash did not check out). Place "
                 "palivane_detect.py next to this script, or reinstall with install.sh.")
    mod = types.ModuleType("palivane_detect")
    mod.__file__ = f"{base}/cli/palivane_detect.py"
    sys.modules["palivane_detect"] = mod
    exec(compile(body, "palivane_detect.py", "exec"), mod.__dict__)
    return mod
# <<< palivane detect-loader


# Detection is shared with palivane-secrets and palivane-s3-scan and lives beside this
# script. The CLIs are downloaded individually, so fall back to fetching it from the same
# deployment this scanner reports to rather than failing with an ImportError.
def _load_detect():
    import importlib.util
    here = os.path.dirname(os.path.abspath(__file__))
    path = os.path.join(here, "palivane_detect.py")
    if not os.path.exists(path):
        base = (os.environ.get("PALIVANE_URL") or "").rstrip("/")
        if not base:
            sys.exit("palivane_detect.py not found next to this script and PALIVANE_URL "
                     "is unset, so it cannot be fetched. Download it from "
                     "<your-palivane-url>/cli/palivane_detect.py into the same directory.")
        return _fetch_detect_verified(base)
    spec = importlib.util.spec_from_file_location("palivane_detect", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


detect = _load_detect()

# Obvious-binary paths we never fetch (the content scan can't read them anyway). The tree
# already gives us sizes; this trims the blob-fetch fan-out before we spend an API call.
# .pdf and the OOXML formats are deliberately ABSENT: the extractor reads them, and a
# design doc or an exported spreadsheet committed to a repo holds the same credentials the
# source does. Images stay here — OCR needs Pillow and tesseract, which a stdlib scanner
# will not have; the backend's connector scanning is where images get read.
_BINARY_EXTS = (
    ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".ico", ".webp", ".svg",
    ".zip", ".gz", ".tar", ".tgz", ".bz2", ".xz", ".7z", ".rar", ".jar", ".war",
    ".woff", ".woff2", ".ttf", ".otf", ".eot", ".mp3", ".mp4", ".mov", ".avi",
    ".so", ".dylib", ".dll", ".class", ".wasm", ".o", ".a", ".bin", ".exe",
    ".pyc", ".lock",
)


def _is_binary_path(path: str) -> bool:
    return path.lower().endswith(_BINARY_EXTS)


def _gh_request(path: str, token: str, api: str) -> tuple[dict | list, dict]:
    """One GitHub API GET. `path` may be a full URL (pagination `next`) or an api-relative
    path. Returns (parsed-json, response-headers). Raises urllib.error.HTTPError on non-2xx."""
    url = path if path.startswith("http") else api.rstrip("/") + path
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github+json",
        "User-Agent": "palivane-github-scan/1.0",
    })
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read()), dict(r.headers)


def _gh_get(path: str, token: str, api: str) -> dict | list:
    """JSON body of a single GitHub GET (no pagination). See _gh_paged for list endpoints."""
    body, _ = _gh_request(path, token, api)
    return body


def _next_link(link_header: str) -> str | None:
    """Extract the rel="next" URL from a GitHub Link header, if present."""
    for part in link_header.split(","):
        seg = part.split(";")
        if len(seg) >= 2 and 'rel="next"' in seg[1] and "<" in seg[0]:
            return seg[0].strip().strip("<>")
    return None


def _gh_paged(path: str, token: str, api: str) -> list:
    """Follow Link rel="next" and concatenate every page of a list endpoint."""
    out: list = []
    url = path
    while url:
        body, headers = _gh_request(url, token, api)
        if isinstance(body, list):
            out.extend(body)
        url = _next_link(headers.get("Link", ""))
    return out


def _is_ratelimited(e: urllib.error.HTTPError) -> bool:
    """A 403 with X-RateLimit-Remaining: 0 is the abuse/rate-limit stop signal."""
    return e.code == 403 and str(e.headers.get("X-RateLimit-Remaining", "")).strip() == "0"


def enumerate_repos(args, token: str, api: str) -> list[dict]:
    """Repos to scan: --org / --user list endpoints (paginated) + each explicit --repo. Skips
    archived and fork repos unless --include-archived."""
    repos: list[dict] = []
    if args.org:
        repos += _gh_paged(f"/orgs/{args.org}/repos?per_page=100", token, api)
    if args.user:
        repos += _gh_paged(f"/users/{args.user}/repos?per_page=100", token, api)
    for full in args.repo or []:
        owner, _, name = full.partition("/")
        if owner and name:
            r = _gh_get(f"/repos/{owner}/{name}", token, api)
            if isinstance(r, dict):
                repos.append(r)
    if not args.include_archived:
        repos = [r for r in repos if not r.get("archived") and not r.get("fork")]
    return repos


def repo_blobs(repo: dict, args, token: str, api: str) -> list[dict]:
    """Tree entries worth scanning for one repo: type==blob, size <= --max-file-bytes, not an
    obvious-binary path. Each item carries the blob sha + path for the later blob fetch."""
    owner = (repo.get("owner") or {}).get("login", "")
    name = repo.get("name", "")
    branch = args.branch or repo.get("default_branch") or "HEAD"
    tree = _gh_get(f"/repos/{owner}/{name}/git/trees/{branch}?recursive=1", token, api)
    entries = tree.get("tree", []) if isinstance(tree, dict) else []
    kept = []
    for e in entries:
        if e.get("type") != "blob":
            continue
        if int(e.get("size", 0) or 0) > args.max_file_bytes:
            continue
        path = e.get("path", "")
        if _is_binary_path(path):
            continue
        kept.append({"owner": owner, "repo": name, "branch": branch,
                     "path": path, "sha": e.get("sha", "")})
    return kept


def scan_blob(item: dict, token: str, api: str) -> dict | None:
    """scan_blob_detail's result alone."""
    return scan_blob_detail(item, token, api)[0]


def scan_blob_detail(item: dict, token: str, api: str) -> tuple[dict | None, bool]:
    """Fetch a blob, decode it, and scan it locally. Returns the file's findings labelled
    owner/repo@branch:path, None if it scanned clean (a clean file is not reported at all —
    "we looked and found nothing" needs no evidence sent anywhere), or UNREADABLE if it
    could not be decoded as text. The bool is True when only part of the file was read (a
    PDF stream that would not inflate): a clean result on it is not a clean file.

    The blob's text is read into memory here and dropped here. It is never returned to the
    caller, so there is no path by which it reaches the request body."""
    blob = _gh_get(f"/repos/{item['owner']}/{item['repo']}/git/blobs/{item['sha']}", token, api)
    if not isinstance(blob, dict) or blob.get("encoding") != "base64":
        return UNREADABLE, False
    try:
        raw = base64.b64decode(blob.get("content", ""))
    except ValueError:
        return UNREADABLE, False
    # Plain source directly; a PDF or Office document in the repo through the extractor —
    # design docs and exported spreadsheets get committed, and they hold the same secrets.
    if hasattr(detect, "extract_text_detail"):
        text, partial = detect.extract_text_detail(item.get("path", ""), raw)
    else:                     # an older palivane_detect.py installed beside this script
        text, partial = detect.extract_text(item.get("path", ""), raw), False
    if not text:
        return UNREADABLE, False
    partial = partial or len(text) > MAX_CONTENT
    found = detect.scan_all(text[:MAX_CONTENT])
    if not found:
        return None, partial
    label = f"{item['owner']}/{item['repo']}@{item['branch']}:{item['path']}"
    return {"path": label, "findings": [{"category": c, "label": lbl, "line": ln, "masked": mk}
                                        for c, lbl, ln, mk in found]}, partial


def scan_batch(url: str, token: str, files: list[dict], record: bool) -> dict:
    """POST a batch of findings to the Palivane backend. Raises on HTTP/network error."""
    payload = json.dumps({"files": files, "record": record}).encode()
    req = urllib.request.Request(
        url.rstrip("/") + "/api/scan/code", data=payload, method="POST",
        headers={"content-type": "application/json", "X-Palivane-Token": token},
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())


def _print_flagged(flagged: list[dict]) -> bool:
    """Print each flagged file; return True if any is a block-level finding."""
    blocking = False
    for f in flagged:
        mark = "🔴 BLOCK" if f["action"] == "block" else "🟠 WARN "
        cats = ", ".join(dict.fromkeys(s["category"] for s in f.get("signals", [])))
        print(f"    {mark}  {f['path']}  [{cats}]")
        if f["action"] == "block":
            blocking = True
    return blocking


def main() -> int:
    ap = argparse.ArgumentParser(description="Scan whole GitHub repos/orgs for secrets & PII via Palivane.")
    ap.add_argument("--org", help="scan every repo in this GitHub org")
    ap.add_argument("--user", help="scan every repo owned by this GitHub user")
    ap.add_argument("--repo", action="append", help="explicit repo owner/name (repeatable)")
    ap.add_argument("--branch", help="branch to scan (default: each repo's default branch)")
    ap.add_argument("--max-file-bytes", type=int, default=1_000_000, help="skip blobs larger than this")
    ap.add_argument("--max-files", type=int, default=5000, help="overall cap on files scanned")
    ap.add_argument("--url", default=os.getenv("PALIVANE_URL", "http://localhost:8088"))
    ap.add_argument("--github-api", default=os.getenv("GITHUB_API_URL", GITHUB_API),
                    help="GitHub API base URL (for GitHub Enterprise)")
    ap.add_argument("--include-archived", action="store_true", help="also scan archived and fork repos")
    ap.add_argument("--record", action="store_true", help="persist findings in Palivane")
    ap.add_argument("--fail-closed", action="store_true", help="fail if GitHub/backend is unreachable")
    args = ap.parse_args()

    if not (args.org or args.user or args.repo):
        print("palivane: give at least one of --org / --user / --repo.", file=sys.stderr)
        return 2

    token = os.getenv("PALIVANE_TOKEN", "")
    gh_token = os.getenv("GITHUB_TOKEN", "")
    if not token:
        print("palivane: PALIVANE_TOKEN is not set — skipping scan.", file=sys.stderr)
        return 1 if args.fail_closed else 0
    if not gh_token:
        print("palivane: GITHUB_TOKEN is not set — cannot reach the GitHub API.", file=sys.stderr)
        return 1 if args.fail_closed else 0

    api = args.github_api
    try:
        repos = enumerate_repos(args, gh_token, api)
    except urllib.error.HTTPError as e:
        if _is_ratelimited(e):
            print("palivane: GitHub rate limit hit — stopping.", file=sys.stderr)
            return 1 if args.fail_closed else 0
        print(f"palivane: GitHub returned HTTP {e.code} enumerating repos.", file=sys.stderr)
        return 1 if args.fail_closed else 0
    except (urllib.error.URLError, OSError, ValueError) as e:
        print(f"palivane: could not reach GitHub ({e}).", file=sys.stderr)
        return 1 if args.fail_closed else 0

    if not repos:
        print("palivane: no repos to scan.")
        return 0

    total_scanned, total_flagged, total_binary, total_partial, blocking = 0, 0, 0, 0, False
    remaining = args.max_files

    for repo in repos:
        label = f"{(repo.get('owner') or {}).get('login', '')}/{repo.get('name', '')}"
        if remaining <= 0:
            print(f"palivane: --max-files ({args.max_files}) reached — stopping.", file=sys.stderr)
            break
        try:
            items = repo_blobs(repo, args, gh_token, api)[:remaining]
            # Every blob is read and scanned here; only the ones with findings survive
            # into `files`, and they carry findings rather than text.
            files: list[dict] = []
            for it in items:
                hit, partial = scan_blob_detail(it, gh_token, api)
                if hit is UNREADABLE:
                    total_binary += 1
                    continue
                total_scanned += 1
                total_partial += partial
                if hit is not None:
                    files.append(hit)
            remaining -= len(items)
        except urllib.error.HTTPError as e:
            if _is_ratelimited(e):
                print("palivane: GitHub rate limit hit — stopping.", file=sys.stderr)
                return 1 if args.fail_closed else 0
            print(f"palivane: GitHub HTTP {e.code} on {label} — skipping repo.", file=sys.stderr)
            continue
        except (urllib.error.URLError, OSError, ValueError) as e:
            print(f"palivane: GitHub error on {label} ({e}) — skipping repo.", file=sys.stderr)
            continue

        if not files:
            # Nothing sensitive in this repo, so there is nothing to report — no request
            # is made at all, rather than one saying "here are N clean files".
            print(f"  {label}: clean ✓" if items else f"  {label}: no scannable files.")
            continue

        repo_flagged: list[dict] = []
        try:
            for i in range(0, len(files), BATCH):
                result = scan_batch(args.url, token, files[i:i + BATCH], args.record)
                repo_flagged.extend(result.get("files", []))
        except urllib.error.HTTPError as e:
            print(f"palivane: backend returned HTTP {e.code} on {label}.", file=sys.stderr)
            if args.fail_closed:
                return 1
            continue
        except (urllib.error.URLError, OSError, ValueError) as e:
            print(f"palivane: could not reach backend ({e}) on {label}.", file=sys.stderr)
            if args.fail_closed:
                return 1
            continue

        total_flagged += len(repo_flagged)
        if repo_flagged:
            print(f"\n  ⚠ {label}: sensitive data in {len(repo_flagged)} file(s):")
            blocking = _print_flagged(repo_flagged) or blocking
        else:
            print(f"  {label}: clean ✓")

    binary = f", skipped {total_binary} binary/unreadable" if total_binary else ""
    binary += f", {total_partial} only partly read" if total_partial else ""
    print(f"\npalivane: scanned {total_scanned} file(s) across {len(repos)} repo(s) "
          f"locally{binary} — {total_flagged} flagged. No file contents left this machine.")
    return 1 if blocking else 0


if __name__ == "__main__":
    sys.exit(main())
